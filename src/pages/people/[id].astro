---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
	const teaching = await getCollection('teaching');
	return teaching.map((prof) => ({
		params: { id: prof.id },
		props: { prof },
	}));
}

const { prof } = Astro.props;
const { name, designation, email, phone, research_areas, photo } = prof.data;

// Research areas list faculty by file name (e.g. "RupjyotiGogoi"), while
// entry ids are lower-case ("rupjyotigogoi"), so compare case-insensitively.
const research = await getCollection('research');
const researchAreas = research.filter((area) =>
	area.data.faculties.some((f) => f.id.toLowerCase() === prof.id),
);

// Scholars name their supervisor in free text ("Prof. Mrinal Kr. Das"), so
// match on this person's first and last name both appearing.
const nameParts = name.toLowerCase().split(/\s+/);
const [firstName, lastName] = [nameParts[0], nameParts[nameParts.length - 1]];
const supervises = (supervisor: string) => {
	const s = supervisor.toLowerCase();
	return s.includes(firstName) && s.includes(lastName);
};
const scholars = (await getCollection('researchScholars'))
	.filter((s) => supervises(s.data.supervisor))
	.sort((a, b) => a.data.name.localeCompare(b.data.name));

const courses = (await getCollection('courses')).filter((c) => supervises(c.data.faculty));

const initials = name
	.split(/\s+/)
	.map((word) => word[0])
	.slice(0, 2)
	.join('');
const hasEmail = email && email.includes('@');
---

<Layout title={name} description={`${name}, ${designation}, Department of Physics, Tezpur University.`}>
	<PageHeader title={name} crumbs={[{ label: 'People', href: '/people' }]}>
		<p class="lead">{designation}</p>
	</PageHeader>

	<div class="container detail-layout">
		<div>
			{research_areas.length > 0 && (
				<section class="profile-section">
					<h2>Research interests</h2>
					<ul class="chip-list">
						{research_areas.map((area) => <li class="chip">{area}</li>)}
					</ul>
				</section>
			)}

			{researchAreas.length > 0 && (
				<section class="profile-section">
					<h2>Research groups</h2>
					<ul class="grid">
						{researchAreas.map((area) => {
							const entry = area.data.faculties.find((f) => f.id.toLowerCase() === prof.id);
							return (
								<li>
									<article class="card card--link">
										<div class="card__body">
											{entry?.group && <span class="card__eyebrow">{entry.group}</span>}
											<h3 class="card__title"><a href={withBase(`/research/${area.id}`)}>{area.data.specialization}</a></h3>
											{area.data.description && <p class="card__text">{area.data.description}</p>}
										</div>
									</article>
								</li>
							);
						})}
					</ul>
				</section>
			)}

			{scholars.length > 0 && (
				<section class="profile-section">
					<h2>Research scholars supervised</h2>
					<ul class="scholar-list">
						{scholars.map((s) => (
							<li>
								<strong>{s.data.name}</strong>
								{s.data.research_area && <span class="text-muted"> — {s.data.research_area}</span>}
							</li>
						))}
					</ul>
				</section>
			)}

			{courses.length > 0 && (
				<section class="profile-section">
					<h2>Courses</h2>
					<ul class="scholar-list">
						{courses.map((c) => (
							<li><a href={withBase(`/academics/courses/${c.id}`)}>{c.data.code}: {c.data.title}</a></li>
						))}
					</ul>
				</section>
			)}

			<a class="back-link" href={withBase('/people')}><Icon name="arrow-left" /> All people</a>
		</div>

		<aside>
			<div class="aside-card profile-card">
				<div class="avatar avatar--lg">
					{photo ? <img src={withBase(`/People-photos/${photo}`)} alt={name} /> : initials}
				</div>
				<h2>Contact</h2>
				<ul class="icon-list">
					{hasEmail && (
						<li><Icon name="mail" /> <a href={`mailto:${email}`}>{email}</a></li>
					)}
					{phone && (
						<li><Icon name="phone" /> <span>{phone}</span></li>
					)}
					{!hasEmail && !phone && <li class="text-muted">Contact details to be added.</li>}
				</ul>
			</div>
		</aside>
	</div>
</Layout>

<style>
	.profile-section + .profile-section {
		margin-top: var(--space-lg);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}

	.profile-section h2 {
		font-size: 1.5rem;
		margin-bottom: var(--space-md);
	}

	.scholar-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}

	.profile-card .avatar {
		margin-bottom: var(--space-md);
	}
</style>
