# Copy to server/.env for local development. Never commit .env.
# For a real server, see docs/portal-trial/DEPLOY_API.md instead.
NODE_ENV=development
HOST=127.0.0.1
PORT=4400
DATABASE_PATH=data/portal.sqlite
BASE_PATH=/dphy
# Local development runs on http://, so cookies can't be Secure there.
# Leave this unset (true) anywhere that uses HTTPS.
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_IDLE_HOURS=8
SESSION_MAX_DAYS=7
# DEVELOPMENT ONLY: password of every fake account made by `npm run seed`.
SEED_PASSWORD=dev-password-123
# Address of the website the portal pages are served from. Every link in an
# email (sign-up, password reset, approval) starts with this, so it must match
# where you open the site: `npm run dev:portal` serves it on port 4331.
SITE_URL=http://localhost:4331
# Registration / password-reset links expire after this many minutes.
LINK_MINUTES=30
# Development: emails are written as text files to OUTBOX_DIR; nothing is sent.
# A real server uses MAIL_MODE=smtp with the SMTP_ settings below (see DEPLOY_API.md);
# check them with `npm run mail:test -- you@example.org`.
MAIL_MODE=outbox
OUTBOX_DIR=data/outbox
MAIL_FROM=portal@example.test
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=starttls        # starttls (default) | tls (usually port 465) | none (only if IT says so)
# SMTP_USER=
# SMTP_PASS=
# SMTP_CA_FILE=               # only if the mail server's certificate is signed by an internal CA
# Roll-number prefix -> programme (PHM, PHI, PHP; see the file).
PROGRAMMES_FILE=programmes.conf
# Uploaded note files (outside the web root; back up together with the database).
UPLOADS_DIR=data/uploads
# Largest note file accepted, in MB.
MAX_UPLOAD_MB=20
