---
import BaseLayout from '../layouts/BaseLayout.astro';

const programs = [
  {
    name: 'M.Sc. Physics',
    level: 'Postgraduate',
    duration: '[PLACEHOLDER — e.g. 2 years, 4 semesters]',
    eligibility: '[PLACEHOLDER — e.g. B.Sc. with Physics as a major/honours subject, minimum XX% marks]',
    admission: '[PLACEHOLDER — entrance test conducted by Tezpur University, held annually in Month]',
    seats: '[PLACEHOLDER number]',
  },
  {
    name: 'Ph.D. in Physics',
    level: 'Doctoral',
    duration: '[PLACEHOLDER — e.g. minimum 3 years, maximum 6]',
    eligibility: '[PLACEHOLDER — e.g. M.Sc. in Physics or allied subject with qualifying NET/GATE/JEST or university entrance test score]',
    admission: '[PLACEHOLDER — written test + interview, held [frequency]]',
    seats: '[PLACEHOLDER — funding: fellowship amount/source, if applicable]',
  },
  {
    name: 'B.Sc. Physics (Honours)',
    level: 'Undergraduate',
    duration: '[PLACEHOLDER — e.g. 3 years, 6 semesters]',
    eligibility: '[PLACEHOLDER — e.g. 10+2 with Physics, Chemistry, Mathematics, minimum XX% marks]',
    admission: '[PLACEHOLDER — merit-based / entrance-based, per university UG admission policy]',
    seats: '[PLACEHOLDER number]',
  },
];

// Four course-catalog entries spanning UG/PG/PhD levels, instead of one,
// so the table isn't misleadingly thin.
const courses = [
  { code: '[PLACEHOLDER CODE]', title: '[PLACEHOLDER Course Title, e.g. "Classical Mechanics"]', program: 'UG', semester: '[PLACEHOLDER]' },
  { code: '[PLACEHOLDER CODE]', title: '[PLACEHOLDER Course Title, e.g. "Quantum Mechanics II"]', program: 'PG', semester: '[PLACEHOLDER]' },
  { code: '[PLACEHOLDER CODE]', title: '[PLACEHOLDER Course Title, e.g. "Statistical Mechanics"]', program: 'PG', semester: '[PLACEHOLDER]' },
  { code: '[PLACEHOLDER CODE]', title: '[PLACEHOLDER Course Title, e.g. "Research Methodology & Scientific Writing"]', program: 'PhD coursework', semester: '[PLACEHOLDER]' },
];
---

<BaseLayout title="Academics">
  <section class="hero">
    <div class="container">
      <h1>Academics &amp; Courses</h1>
      <p class="lede">
        The Department of Physics, Tezpur University offers a three-year
        B.Sc. (Physics as a subject, within the university's UG programs),
        a two-year M.Sc. in Physics, and a Ph.D. program in Physics,
        admitting students through [PLACEHOLDER &mdash; entrance test name]
        followed by [PLACEHOLDER &mdash; interview/counseling process].
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="placeholder-note">
        Program details below carry [PLACEHOLDER] figures for eligibility,
        seats, dates, and fees pending confirmation from the department.
      </div>
      <div class="card-grid">
        {programs.map((p) => (
          <div class="card">
            <h3>{p.name}</h3>
            <p>{p.level}</p>
            <p><strong>Duration:</strong> {p.duration}</p>
            <p><strong>Eligibility:</strong> {p.eligibility}</p>
            <p><strong>Admission:</strong> {p.admission}</p>
            <p><strong>Seats:</strong> {p.seats}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Admissions</h2>
      <p>
        Applications open [PLACEHOLDER month] each year via the
        [PLACEHOLDER &mdash; link to Tezpur University admissions portal].
        Fee structure: [PLACEHOLDER &mdash; link to official fee page].
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Course Catalog</h2>
      <table class="simple-table">
        <thead>
          <tr>
            <th>Course Code</th>
            <th>Title</th>
            <th>Program</th>
            <th>Semester</th>
          </tr>
        </thead>
        <tbody>
          {courses.map((c) => (
            <tr>
              <td>{c.code}</td>
              <td>{c.title}</td>
              <td>{c.program}</td>
              <td>{c.semester}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
