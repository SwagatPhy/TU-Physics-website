---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../lib/url';

// The department's actual policies are still pending. Each section keeps a
// [PLACEHOLDER] until the real text arrives via Notes-manager.
const sections = [
	{ id: 'grading', title: 'Grading', text: '[PLACEHOLDER — grading scheme and minimum grades required]' },
	{ id: 'attendance', title: 'Attendance', text: '[PLACEHOLDER — attendance requirement for sitting examinations]' },
	{ id: 'integrity', title: 'Academic integrity', text: '[PLACEHOLDER — policy on plagiarism, collaboration and data fabrication]' },
	{ id: 'progression', title: 'Progression', text: '[PLACEHOLDER — progression requirements for UG, PG and PhD students]' },
];
---

<Layout title="Rules & Regulations" description="Academic rules and regulations of the Department of Physics, Tezpur University.">
	<PageHeader title="Rules & regulations" crumbs={[{ label: 'Academics', href: '/academics' }]} />

	<div class="container detail-layout">
		<div class="prose">
			{sections.map((section) => (
				<section id={section.id}>
					<h2>{section.title}</h2>
					<p>{section.text}</p>
				</section>
			))}
			<a class="back-link" href={withBase('/academics')}><Icon name="arrow-left" /> Academics</a>
		</div>

		<aside>
			<nav class="aside-card" aria-label="On this page">
				<h2>On this page</h2>
				<ul class="toc">
					{sections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}
				</ul>
			</nav>
		</aside>
	</div>
</Layout>

<style>
	.toc {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}
</style>
