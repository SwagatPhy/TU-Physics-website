---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/url';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean; // keep the page out of search results (portal pages)
}

const { title, description = 'Department of Physics, Tezpur University.', noindex = false } = Astro.props;

const navLinks = [
	{ href: '/about', label: 'About' },
	{ href: '/people', label: 'People' },
	{ href: '/academics', label: 'Academics' },
	{ href: '/admissions', label: 'Admissions' },
	{ href: '/research', label: 'Research' },
	{ href: '/facilities', label: 'Facilities' },
	{ href: '/news-events', label: 'News & Events' },
	{ href: '/alumni', label: 'Alumni' },
	{ href: '/contact', label: 'Contact' },
];

// Highlight the nav item for the section we're in (e.g. /people/xyz → People).
// (withBase gives "/dphy/people/", so a prefix match covers sub-pages too.)
const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(withBase(href));

const pageTitle = title === 'Home' ? 'Department of Physics | Tezpur University' : `${title} | Department of Physics, Tezpur University`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#00254e" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="icon" href={withBase('/favicon.ico')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap"
		/>
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<div class="container site-header__inner">
				<a class="brand" href={withBase('/')} aria-label="Department of Physics, Tezpur University — home">
					<svg class="brand__mark" viewBox="0 0 48 48" aria-hidden="true">
						<circle cx="24" cy="24" r="23" fill="#00254e" />
						<g fill="none" stroke="#c7dce5" stroke-width="1.6">
							<ellipse cx="24" cy="24" rx="16" ry="6.5" />
							<ellipse cx="24" cy="24" rx="16" ry="6.5" transform="rotate(60 24 24)" />
							<ellipse cx="24" cy="24" rx="16" ry="6.5" transform="rotate(120 24 24)" />
						</g>
						<circle cx="24" cy="24" r="3.2" fill="#7bd9b0" />
						<circle cx="40" cy="24" r="1.8" fill="#ffbf3e" />
					</svg>
					<span class="brand__text">
						<span class="brand__name">Department of Physics</span>
						<span class="brand__sub">Tezpur University</span>
					</span>
				</a>

				<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
					<Icon name="menu" class="icon-open" />
					<Icon name="close" class="icon-close" />
				</button>

				<nav class="site-nav" id="site-nav" aria-label="Primary">
					<ul>
						{navLinks.map((link) => (
							<li>
								<a href={withBase(link.href)} aria-current={isCurrent(link.href) ? 'page' : undefined}>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-grid">
				<div>
					<a class="brand" href={withBase('/')}>
						<svg class="brand__mark" viewBox="0 0 48 48" aria-hidden="true">
							<circle cx="24" cy="24" r="23" fill="#ffffff" fill-opacity="0.08" />
							<g fill="none" stroke="#c7dce5" stroke-width="1.6">
								<ellipse cx="24" cy="24" rx="16" ry="6.5" />
								<ellipse cx="24" cy="24" rx="16" ry="6.5" transform="rotate(60 24 24)" />
								<ellipse cx="24" cy="24" rx="16" ry="6.5" transform="rotate(120 24 24)" />
							</g>
							<circle cx="24" cy="24" r="3.2" fill="#7bd9b0" />
						</svg>
						<span class="brand__text">
							<span class="brand__name">Department of Physics</span>
							<span class="brand__sub">Tezpur University</span>
						</span>
					</a>
					<address class="footer-address">
						Tezpur University, Napaam<br />
						Tezpur, Assam, India
					</address>
				</div>

				<div>
					<p class="footer-heading">Explore</p>
					<ul class="footer-list">
						<li><a href={withBase('/about')}>About the department</a></li>
						<li><a href={withBase('/research')}>Research areas</a></li>
						<li><a href={withBase('/facilities')}>Facilities &amp; observatory</a></li>
						<li><a href={withBase('/people')}>Faculty &amp; scholars</a></li>
					</ul>
				</div>

				<div>
					<p class="footer-heading">Students</p>
					<ul class="footer-list">
						<li><a href={withBase('/admissions')}>Admissions</a></li>
						<li><a href={withBase('/academics')}>Academics &amp; courses</a></li>
						<li><a href={withBase('/news-events')}>News &amp; events</a></li>
						<li><a href={withBase('/alumni')}>Alumni</a></li>
					</ul>
				</div>

				<div>
					<p class="footer-heading">Resources</p>
					<ul class="footer-list">
						<li><a href={withBase('/Resources-files/program_objectives.pdf')}>Program objectives (PDF)</a></li>
						<li><a href="https://www.tezu.ernet.in" rel="noopener">Tezpur University website</a></li>
						<li><a href={withBase('/contact')}>Contact &amp; directions</a></li>
					</ul>
				</div>
			</div>

			<div class="container footer-bottom">
				<p>&copy; {new Date().getFullYear()} Department of Physics, Tezpur University</p>
				<p><a href="#main">Back to top &uarr;</a></p>
			</div>
		</footer>

		<script>
			// Mobile menu: toggle the nav panel; close it with Escape.
			const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
			const nav = document.getElementById('site-nav');

			function setMenu(open: boolean) {
				toggle?.setAttribute('aria-expanded', String(open));
				nav?.classList.toggle('is-open', open);
			}

			toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));

			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && nav?.classList.contains('is-open')) {
					setMenu(false);
					toggle?.focus();
				}
			});
		</script>
	</body>
</html>
