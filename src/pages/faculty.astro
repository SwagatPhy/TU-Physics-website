---
import BaseLayout from '../layouts/BaseLayout.astro';

// Structural placeholders only — no real people. This mix (HoD, associate/
// assistant professors, emeritus, technical staff) is a template for the
// real roster's spread, not a claim about actual headcount or ratios.
// Replace with the actual roster once the department confirms it.
const facultyPlaceholders = [
  {
    name: '[PLACEHOLDER NAME 1], Ph.D.',
    title: 'Professor · Head of Department',
    area: '[PLACEHOLDER — e.g. Condensed Matter Physics, Materials Science]',
    email: '[PLACEHOLDER — name@tezu.ac.in]',
  },
  {
    name: '[PLACEHOLDER NAME 2], Ph.D.',
    title: 'Associate Professor',
    area: '[PLACEHOLDER — e.g. Nuclear & Particle Physics]',
    email: '[PLACEHOLDER — name@tezu.ac.in]',
  },
  {
    name: '[PLACEHOLDER NAME 3], Ph.D.',
    title: 'Assistant Professor',
    area: '[PLACEHOLDER — e.g. Optics & Photonics]',
    email: '[PLACEHOLDER — name@tezu.ac.in]',
  },
  {
    name: '[PLACEHOLDER NAME 4], Ph.D.',
    title: 'Professor Emeritus',
    area: '[PLACEHOLDER — e.g. Astrophysics]',
    email: '[PLACEHOLDER — name@tezu.ac.in] (optional for emeritus listing)',
  },
  {
    name: '[PLACEHOLDER NAME 5]',
    title: 'Technical Officer / Laboratory In-Charge',
    area: 'Supports: [PLACEHOLDER — e.g. Advanced Physics Lab, Electronics Lab]',
    email: '[PLACEHOLDER — name@tezu.ac.in]',
  },
];
---

<BaseLayout title="Faculty">
  <section class="hero">
    <div class="container">
      <h1>Faculty</h1>
      <p class="lede">
        Directory of the Department of Physics faculty. No real names
        below &mdash; structural placeholders pending the confirmed
        roster, photos, and profile links.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="placeholder-note">
        No real names below. Structural placeholders only, pending the
        department's confirmed roster, headshots, bios, and contact
        details.
      </div>
      <div class="card-grid">
        {facultyPlaceholders.map((f) => (
          <div class="card">
            <h3>{f.name}</h3>
            <p>{f.title}</p>
            <p>{f.area}</p>
            <p>{f.email}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
