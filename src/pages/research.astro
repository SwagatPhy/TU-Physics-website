---
import BaseLayout from '../layouts/BaseLayout.astro';

// Area names below are generic examples of common Indian physics-department
// research groupings — NOT a claim about what this department actually
// researches. Replace with the department's real, confirmed groups.
const researchAreas = [
  { title: '[PLACEHOLDER] Condensed Matter Physics', body: 'Studies the physical properties of materials, including [PLACEHOLDER sub-topics], using both theoretical modeling and experimental techniques. Faculty: [PLACEHOLDER names]' },
  { title: '[PLACEHOLDER] Nuclear &amp; Particle Physics', body: 'Investigates [PLACEHOLDER sub-topics] using [PLACEHOLDER methods/facilities]. Faculty: [PLACEHOLDER names]' },
  { title: '[PLACEHOLDER] Optics &amp; Photonics', body: 'Focuses on [PLACEHOLDER sub-topics] with applications in [PLACEHOLDER application area]. Faculty: [PLACEHOLDER names]' },
  { title: '[PLACEHOLDER] Materials Science', body: 'Explores synthesis and characterization of [PLACEHOLDER material types] for [PLACEHOLDER applications]. Faculty: [PLACEHOLDER names]' },
];
---

<BaseLayout title="Research">
  <section class="hero">
    <div class="container">
      <h1>Research</h1>
      <p class="lede">
        Research in the Department of Physics, Tezpur University spans
        several areas of theoretical and experimental physics. Faculty and
        research scholars actively publish in peer-reviewed journals and
        undertake sponsored research projects supported by national
        funding agencies.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="placeholder-note">
        Area names and descriptions below are generic examples of common
        Indian physics-department research groupings &mdash; NOT a claim
        about what this department actually researches. Replace with the
        department's real, confirmed groups.
      </div>
      <div class="card-grid">
        {researchAreas.map((area) => (
          <div class="card">
            <h3 set:html={area.title} />
            <p set:html={area.body} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
