---
import BaseLayout from '../layouts/BaseLayout.astro';

// Area names below are generic examples of common Indian physics-department
// research groupings — NOT a claim about what this department actually
// researches. Replace with the department's real, confirmed groups.
const researchAreas = [
  { title: '[PLACEHOLDER] Condensed Matter Physics', body: 'Studies the physical properties of materials, including [PLACEHOLDER sub-topics], using both theoretical modeling and experimental techniques. Faculty: [PLACEHOLDER names]' },
  { title: '[PLACEHOLDER] Nuclear &amp; Particle Physics', body: 'Investigates [PLACEHOLDER sub-topics] using [PLACEHOLDER methods/facilities]. Faculty: [PLACEHOLDER names]' },
  { title: '[PLACEHOLDER] Optics &amp; Photonics', body: 'Focuses on [PLACEHOLDER sub-topics] with applications in [PLACEHOLDER application area]. Faculty: [PLACEHOLDER names]' },
  { title: '[PLACEHOLDER] Materials Science', body: 'Explores synthesis and characterization of [PLACEHOLDER material types] for [PLACEHOLDER applications]. Faculty: [PLACEHOLDER names]' },
  { title: '[PLACEHOLDER] Astrophysics &amp; Space Physics', body: 'Studies [PLACEHOLDER sub-topics &mdash; e.g. stellar/galactic phenomena, space weather] through [PLACEHOLDER methods &mdash; observation/simulation/data analysis]. Faculty: [PLACEHOLDER names]' },
  { title: '[PLACEHOLDER] Theoretical &amp; Mathematical Physics', body: 'Works on [PLACEHOLDER sub-topics] using analytical and computational methods, often in collaboration with the department&rsquo;s experimental groups. Faculty: [PLACEHOLDER names]' },
];

const fundedProjects = [
  { title: '[PLACEHOLDER Project Title]', pi: '[PLACEHOLDER PI name]', agency: '[PLACEHOLDER agency — e.g. DST-SERB]', detail: '[PLACEHOLDER duration/amount]' },
  { title: '[PLACEHOLDER Project Title]', pi: '[PLACEHOLDER PI name]', agency: '[PLACEHOLDER agency — e.g. UGC]', detail: '[PLACEHOLDER duration/amount]' },
];

// Current default — a second phrasing (more conversational, "browse and
// email") is drafted in content-notes/research.md if a friendlier tone
// fits better once the department weighs in.
const studentOpportunities = 'Undergraduate and postgraduate students can join a research group for project work, dissertations, or summer research under faculty supervision — reach out to a group’s faculty contact directly to discuss opportunities.';
---

<BaseLayout title="Research">
  <section class="hero">
    <div class="container">
      <h1>Research</h1>
      <p class="lede">
        Research in the Department of Physics, Tezpur University spans
        several areas of theoretical and experimental physics. Faculty and
        research scholars actively publish in peer-reviewed journals and
        undertake sponsored research projects supported by national
        funding agencies.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="placeholder-note">
        Area names and descriptions below are generic examples of common
        Indian physics-department research groupings &mdash; NOT a claim
        about what this department actually researches. Replace with the
        department's real, confirmed groups.
      </div>
      <div class="card-grid">
        {researchAreas.map((area) => (
          <div class="card">
            <h3 set:html={area.title} />
            <p set:html={area.body} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Funded Projects</h2>
      <ul>
        {fundedProjects.map((project) => (
          <li><strong>{project.title}</strong> &mdash; {project.pi}, funded by {project.agency}, {project.detail}.</li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Student Research Opportunities</h2>
      <p>{studentOpportunities}</p>
    </div>
  </section>
</BaseLayout>
