---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';

// Copy from content-notes/alumni.md. Everything marked [PLACEHOLDER] is
// pending from the department.
const impact = ['Total alumni', 'Countries', 'Research publications', 'Faculty positions'];

const spotlights = [
	{ track: 'Research & academia' },
	{ track: 'Industry leadership' },
	{ track: 'Public service & policy' },
];

const network = [
	{
		title: 'Alumni events & reunions',
		text: 'Department anniversary celebration, regional alumni meetups and a homecoming seminar series. [PLACEHOLDER — dates and cities]',
	},
	{
		title: 'Mentorship',
		text: 'Connect with students pursuing your research area or career path.',
	},
	{
		title: 'Collaboration & research',
		text: 'Reach out to fellow alumni working on complementary topics.',
	},
	{
		title: 'Visiting lectures',
		text: 'Alumni return to campus for seminars, lab visits and career talks. [PLACEHOLDER — number of talks last academic year]',
	},
];
---

<Layout title="Alumni" description="The alumni community of the Department of Physics, Tezpur University.">
	<PageHeader
		title="Our alumni community"
		eyebrow="Alumni"
		lead="Our graduates shape careers in research, academia, industry, and beyond. Join a global network of physicists making an impact on science and society."
	>
		<div class="btn-row header-actions">
			<a class="btn btn--navy" href="#stories">Explore stories</a>
			<a class="btn btn--outline" href="#connect">Stay connected</a>
		</div>
	</PageHeader>

	<section class="section section--tight">
		<div class="container">
			<ul class="stats">
				{impact.map((label) => (
					<li class="stat">
						<span class="stat__value stat__value--pending">[PLACEHOLDER]</span>
						<span class="stat__label">{label}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section section--soft" id="stories">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">Spotlights</p>
					<h2>Alumni stories</h2>
					<p>Meet our alumni making a difference in the world.</p>
				</div>
			</div>
			<ul class="grid">
				{spotlights.map((story) => (
					<li>
						<article class="card">
							<div class="card__media story-media" aria-hidden="true">
								<span>[PLACEHOLDER photo]</span>
							</div>
							<div class="card__body">
								<span class="card__eyebrow">{story.track}</span>
								<h3 class="card__title">[PLACEHOLDER — Alumni name]</h3>
								<p class="card__text text-muted">[PLACEHOLDER — Current position/organization]</p>
								<p class="card__text">[PLACEHOLDER — Brief career journey and achievements]</p>
							</div>
						</article>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">Community</p>
					<h2>Alumni network</h2>
				</div>
			</div>
			<ul class="grid">
				{network.map((item) => (
					<li class="network-item">
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section section--navy" id="connect">
		<div class="container grid grid--wide">
			<div>
				<h2 class="connect-title">Stay connected</h2>
				<p>
					Quarterly updates on department achievements, alumni news, events, and opportunities.
					[PLACEHOLDER — newsletter subscription link]
				</p>
			</div>
			<div>
				<h3>Give back</h3>
				<p>
					Contributions from alumni can support scholarships, research equipment, student travel and alumni
					events. [PLACEHOLDER — how to contribute]
				</p>
			</div>
			<div>
				<h3>Alumni coordinator</h3>
				<ul class="icon-list">
					<li><Icon name="mail" /> [PLACEHOLDER alumni@tezu.ac.in]</li>
					<li><Icon name="phone" /> [PLACEHOLDER +91-XXXX-XXXXXX]</li>
					<li><Icon name="map-pin" /> [PLACEHOLDER Department of Physics, Building/Block, Room #]</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container container--narrow">
			<div class="pending">
				<Icon name="users" />
				<p>
					<strong>Alumni directory.</strong> Search for classmates by name, graduation year, or research area.
					[PLACEHOLDER — Searchable alumni directory]
				</p>
			</div>
		</div>
	</section>
</Layout>

<style>
	.header-actions {
		margin-top: var(--space-md);
	}

	.stat__value--pending {
		font-size: 1.1rem;
		color: var(--slate);
	}

	.story-media {
		display: grid;
		place-items: center;
		color: var(--slate);
		font-size: 0.9rem;
		background:
			radial-gradient(circle at 30% 30%, rgba(123, 217, 176, 0.25), transparent 50%),
			var(--color-bg-soft);
	}

	.network-item {
		padding-top: var(--space-md);
		border-top: 2px solid var(--mint);
	}

	.network-item p {
		margin: 0;
	}

	.connect-title {
		font-size: 1.6rem;
	}

	.section--navy .icon-list .icon {
		color: var(--mint);
	}
</style>
