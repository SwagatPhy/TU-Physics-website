---
import Layout from '../../layouts/Layout.astro';
import AdmissionsAudience from '../../components/AdmissionsAudience.astro';

// From content-notes/admissions-national.md ("General Information").
const info = [
	{
		title: 'Admission portal',
		items: ['[PLACEHOLDER — Tezpur University Admissions Portal URL]'],
	},
	{
		title: 'Fees & support',
		items: [
			'<strong>Application fee (all programs):</strong> [PLACEHOLDER amount in INR]',
			'<strong>Tuition per semester:</strong> [PLACEHOLDER amount]',
			'<strong>Scholarships:</strong> [PLACEHOLDER — Merit-based / Need-based / UGC-CSIR / DST-INSPIRE / Others]',
		],
	},
	{
		title: 'Contact',
		items: [
			'Department of Physics, Tezpur University',
			'[PLACEHOLDER — Address/Building location]',
			'<strong>Email:</strong> [PLACEHOLDER physics@tezu.ac.in]',
			'<strong>Phone:</strong> [PLACEHOLDER +91-XXXX-XXXXXX]',
			'<strong>Office hours:</strong> [PLACEHOLDER Mon–Fri, 10:00 AM – 4:00 PM IST]',
		],
	},
];
---

<Layout title="National Admissions" description="Admissions information for Indian students at the Department of Physics, Tezpur University.">
	<AdmissionsAudience
		audience="national"
		title="National admissions"
		lead="Information and guidelines for Indian students applying to the Department of Physics."
		info={info}
	/>
</Layout>
