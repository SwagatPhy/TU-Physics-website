---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro'

const levels = (await getCollection('research')).sort((a,b) => a.data.specialization.localeCompare(b.data.specialization));
---

<Layout title="research" description="Current research going on in the Department of Physics.">
    <header class="page-header container">
        <div>
            <h1>Research</h1>
            <p>
                Research in the Department of Physics spans several areas of theoretical and experimental physics. Faculty and research scholars actively publish in peer-reviewed journals and undertake sponsored research projects.
            </p>
        </div>
    </header>

    <section class="research-areas container">
        <div class="card-grid research-grid">
            {levels.map(item => (
                <article class="card research-card">
                    <a href={`/research/${item.id}`} class="card-link">
                        {item.data.image && (
                            <img src={`/Research-areas/${item.data.image}`} alt={item.data.specialization} class="card-image" />
                        )}
                        <h3 class="card-title">{item.data.specialization}</h3>
                        <p class="card-summary">{item.data.description}</p>
                    </a>

                    <div class="faculty-overlay">
                        <div class="faculty-list">
                            {item.data.faculties.map(faculty => (
                                <a href={faculty.url || '#'} class="faculty-link">
                                    <div class="faculty-name">{faculty.name}</div>
                                    <div class="faculty-group">{faculty.group}</div>
                                </a>
                            ))}
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </section>
</Layout>

<style>
    /* Four-column board: 4 tiles per row, remaining tiles wrap below */
    .research-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
    }

    .research-card {
        position: relative;
        padding: 0.75rem;
    }

    .card-link {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .card-image {
        width: 100%;
        height: 140px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 0.75rem;
    }

    .faculty-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
    }

    .research-card:hover .faculty-overlay,
    .research-card:focus-within .faculty-overlay {
        opacity: 1;
        pointer-events: auto;
    }

    .faculty-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
        padding: 1rem;
        text-align: center;
    }

    .faculty-link {
        display: block;
        text-decoration: none;
        color: white;
        transition: opacity 0.2s ease;
    }

    .faculty-link:hover {
        opacity: 0.8;
    }

    .faculty-name {
        font-weight: bold;
        margin-bottom: 0.25rem;
        font-size: 0.95rem;
    }

    .faculty-group {
        font-size: 0.85rem;
        opacity: 0.9;
    }

    @media (max-width: 64rem) {
        .research-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 36rem) {
        .research-grid { grid-template-columns: 1fr; }
    }
</style>
