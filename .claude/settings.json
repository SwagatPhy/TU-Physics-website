{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Artifact",
      "SendMessage",
      "Monitor"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "Planning-manager",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"📢 Planning-manager TU message received\"}'"
          }
        ]
      }
    ]
  }
}
