---
// Forgot password. Without a token: ask for a reset link by email.
// With #token=… (from the emailed link): choose a new password.
// States: loading → unavailable | request | requested | complete | done.
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PortalPanel from '../components/PortalPanel.astro';
import { copy } from '../lib/portal-copy';
import { portalPages } from '../lib/api';

const text = copy.forgotPassword;
---

<Layout title={text.title} noindex>
	<PageHeader title={text.title} lead={text.intro} crumbs={[{ label: copy.login.title, href: '/login' }]} />

	<section class="section">
		<div class="container">
			<PortalPanel>
				<div data-state="request" hidden>
					<form class="portal-form" id="request-form" novalidate>
						<div class="portal-field">
							<label for="forgot-email">{text.email}</label>
							<input id="forgot-email" name="email" type="email" autocomplete="email" required />
						</div>
						<button class="btn btn--navy" type="submit">{text.requestSubmit}</button>
					</form>
				</div>

				<div data-state="requested" hidden>
					<p>{copy.checkYourEmail}</p>
				</div>

				<div data-state="complete" hidden>
					<p>{text.completeIntro}</p>
					<form class="portal-form" id="complete-form" novalidate>
						<div class="portal-field">
							<label for="forgot-password">{text.password}</label>
							<input id="forgot-password" name="password" type="password" autocomplete="new-password" minlength="10" maxlength="200" required aria-describedby="forgot-rule" />
							<p class="portal-field__hint" id="forgot-rule">{text.passwordRule}</p>
						</div>
						<div class="portal-field">
							<label for="forgot-confirm">{text.confirmPassword}</label>
							<input id="forgot-confirm" name="confirmPassword" type="password" autocomplete="new-password" required />
						</div>
						<button class="btn btn--navy" type="submit">{text.completeSubmit}</button>
					</form>
				</div>

				<div data-state="done" hidden>
					<p>{text.done}</p>
					<a class="btn btn--navy" href={portalPages.login}>{text.loginLink}</a>
				</div>
			</PortalPanel>
		</div>
	</section>
</Layout>

<script>
	import { api } from '../lib/api';
	import { showState, showMessage, showError, portalIsAvailable, onSubmit, watchForToken, passwordsMatch } from '../lib/portal-ui';

	let token: string | null = null;

	onSubmit(document.getElementById('request-form') as HTMLFormElement, async ({ email }) => {
		const result = await api('password-reset/request', { method: 'POST', body: { email } });
		if (result.error === 'unavailable') return showState('unavailable');
		if (!result.ok) return showError(result);
		showState('requested');
	});

	onSubmit(document.getElementById('complete-form') as HTMLFormElement, async ({ password, confirmPassword }) => {
		if (!passwordsMatch(password, confirmPassword)) return;
		const result = await api('password-reset/complete', { method: 'POST', body: { token, password } });
		if (result.error === 'unavailable') return showState('unavailable');
		if (result.error === 'invalid_or_expired_link') {
			showState('request');
			return showError(result);
		}
		if (!result.ok) return showError(result);
		showState('done');
	});

	async function start() {
		if (!(await portalIsAvailable())) return;
		watchForToken((newToken) => {
			token = newToken;
			showMessage('');
			showState(token ? 'complete' : 'request');
		});
	}
	start();
</script>
