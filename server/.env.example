# Copy to server/.env for local development. Never commit .env.
NODE_ENV=development
PORT=4400
DATABASE_PATH=data/portal.sqlite
BASE_PATH=/dphy
# Local development runs on http://, so cookies can't be Secure there.
# Leave this unset (true) anywhere that uses HTTPS.
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_IDLE_HOURS=8
SESSION_MAX_DAYS=7
# Password given to every seeded (fake) account. Each must change it on first login.
SEED_PASSWORD=trial-password-123
# Address of the website the portal pages are served from. Every link in an
# email (sign-up, password reset, approval) starts with this, so it must match
# where you open the site: `npm run dev:portal` serves it on port 4331.
SITE_URL=http://localhost:4331
# Registration / password-reset links expire after this many minutes.
LINK_MINUTES=30
# Emails are written as text files to OUTBOX_DIR instead of being sent.
MAIL_MODE=outbox
OUTBOX_DIR=data/outbox
MAIL_FROM=portal@example.test
# Which roll-number prefixes exist (TEMPORARY placeholders, see the file).
PROGRAMMES_FILE=programmes.conf
# Uploaded note files (outside the web root; back up together with the database).
UPLOADS_DIR=data/uploads
# Largest note file accepted, in MB.
MAX_UPLOAD_MB=20
