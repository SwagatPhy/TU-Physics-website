---
import Layout from '../../layouts/Layout.astro';
import AdmissionsAudience from '../../components/AdmissionsAudience.astro';

// From content-notes/admissions-international.md
// ("General Information for International Students").
const info = [
	{
		title: 'Arrival & support',
		items: [
			'<strong>Pre-arrival:</strong> Contact the International Office for airport pickup arrangements',
			'<strong>FRRO:</strong> Must register within 14 days at the Foreigners Regional Registration Office',
			'<strong>Orientation:</strong> International student orientation is scheduled before the semester starts',
			'<strong>Bank account:</strong> The International Office assists with opening a local bank account',
		],
	},
	{
		title: 'Health insurance',
		items: [
			'<strong>Mandatory:</strong> All international students must maintain health insurance',
			'[PLACEHOLDER — Approved providers, coverage amount, annual premium]',
		],
	},
	{
		title: 'Hostel accommodation',
		items: [
			'[PLACEHOLDER — Separate hostel for international students]',
			'[PLACEHOLDER — Cost: ₹XXXX/month (single room), ₹XXXX/month (shared)]',
			'[PLACEHOLDER — Includes: meals, furniture, internet, utilities]',
		],
	},
	{
		title: 'Living expenses (estimated)',
		items: ['[PLACEHOLDER — Monthly breakdown: hostel/rent, food, transport, phone/internet, misc.]'],
	},
	{
		title: 'On-campus work',
		items: [
			'[PLACEHOLDER — Student Visa permits limited on-campus work: X hours/week during semester]',
			'[PLACEHOLDER — Off-campus work requires special permission (generally not permitted during coursework)]',
		],
	},
	{
		title: 'Contact: International Office',
		items: [
			'<strong>Email:</strong> [PLACEHOLDER international.students@tezu.ac.in]',
			'<strong>Phone:</strong> [PLACEHOLDER +91-XXXX-XXXXXX]',
			'<strong>Office:</strong> [PLACEHOLDER location on campus]',
			'<strong>Hours:</strong> [PLACEHOLDER Mon–Fri, 10:00 AM – 5:00 PM IST]',
		],
	},
];
---

<Layout title="International Admissions" description="Admissions information for international students at the Department of Physics, Tezpur University.">
	<AdmissionsAudience
		audience="international"
		title="International admissions"
		lead="Information and guidelines for international students applying to the Department of Physics."
		info={info}
	/>
</Layout>
