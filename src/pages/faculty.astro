---
// Faculty dashboard: the courses I teach (admin: all courses), each with two
// sections — "Class links" (title + URL) and "Notes" (title + an uploaded
// file and/or a link) — to add, edit and delete.
// States: loading → unavailable | not-logged-in | pending | courses | empty.
// Students who open this page are sent to /portal/.
// Course cards are cloned from the <template>s below; every value from the
// database is set with textContent, never as HTML.
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PortalPanel from '../components/PortalPanel.astro';
import { copy } from '../lib/portal-copy';
import { portalPages } from '../lib/api';

const text = copy.faculty;
// The file types the API accepts (server/src/files.js). The API also checks
// each file's content; this only filters the file picker.
const acceptedFiles = '.pdf,.txt,.md,.csv,.docx,.pptx';
---

<Layout title={text.title} noindex>
	<PageHeader title={text.title} lead={text.intro} />

	<section class="section">
		<div class="container">
			<div class="portal-account" id="portal-account" hidden>
				<p>{text.signedInAs} <strong id="portal-name"></strong></p>
				<button class="btn btn--outline" type="button" id="logout-button">{text.logout}</button>
			</div>

			<PortalPanel>
				<div data-state="pending" hidden>
					<h2>{copy.pending.title}</h2>
					<p>{copy.pending.text}</p>
				</div>
				<div data-state="not-logged-in" hidden>
					<p>{text.notLoggedIn}</p>
					<a class="btn btn--navy" href={portalPages.login}>{text.loginLink}</a>
				</div>
				<div data-state="empty" hidden>
					<p>{text.noCourses}</p>
				</div>
				<div data-state="courses" hidden>
					<p class="portal-message portal-message--error forward-reminder">{text.forwardReminder}</p>
					<ul class="fcourse-list" id="course-list"></ul>
				</div>
			</PortalPanel>
		</div>
	</section>

	<template id="course-template">
		<li class="fcourse">
			<h2 class="fcourse__title" data-field="title"></h2>
			<p class="fcourse__meta" data-field="students"></p>
			<p class="portal-message" role="status" aria-live="polite" data-field="status" hidden></p>

			<h3 class="fcourse__heading">{text.classLinks}</h3>
			<p class="fcourse__none" data-field="noLinks">{text.noLinks}</p>
			<ul class="fcourse__links" data-field="links"></ul>
			<form class="portal-form fcourse__form" data-form="link" novalidate>
				<input type="hidden" name="id" />
				<label class="portal-field">
					{text.linkTitle}
					<input name="title" type="text" maxlength="200" required />
				</label>
				<label class="portal-field">
					{text.url}
					<input name="url" type="url" maxlength="2000" required placeholder="https://" />
					<span class="portal-field__hint">{text.urlHint}</span>
				</label>
				<label class="portal-field">
					{text.visibleFrom}
					<input name="visibleFrom" type="date" />
					<span class="portal-field__hint">{text.visibleFromHint}</span>
				</label>
				<div class="btn-row">
					<button class="btn btn--navy" type="submit" data-field="submit" data-add-label={text.add}>{text.add}</button>
					<button class="btn btn--outline" type="button" data-action="cancel" hidden>{text.cancel}</button>
				</div>
			</form>

			<h3 class="fcourse__heading">{text.notes}</h3>
			<p class="fcourse__none" data-field="noNotes">{text.noNotes}</p>
			<ul class="fcourse__links" data-field="notes"></ul>
			<form class="portal-form fcourse__form" data-form="note" novalidate>
				<input type="hidden" name="id" />
				<label class="portal-field">
					{text.noteTitle}
					<input name="title" type="text" maxlength="200" required />
				</label>
				<label class="portal-field">
					{text.file}
					<input name="file" type="file" accept={acceptedFiles} />
					<span class="portal-field__hint" data-field="currentFile" hidden></span>
				</label>
				<label class="portal-field">
					{text.noteUrl}
					<input name="url" type="url" maxlength="2000" placeholder="https://" />
					<span class="portal-field__hint">{text.urlHint}</span>
				</label>
				<label class="portal-field">
					{text.visibleFrom}
					<input name="visibleFrom" type="date" />
					<span class="portal-field__hint">{text.visibleFromHint}</span>
				</label>
				<div class="btn-row">
					<button class="btn btn--navy" type="submit" data-field="submit" data-add-label={text.addNote}>{text.addNote}</button>
					<button class="btn btn--outline" type="button" data-action="cancel" hidden>{text.cancel}</button>
				</div>
			</form>
		</li>
	</template>

	<template id="item-template">
		<li class="flink">
			<span class="flink__title" data-field="title"></span>
			<a data-field="link" target="_blank" rel="noopener noreferrer" hidden></a>
			<a class="flink__file" data-field="file" download hidden></a>
			<span class="flink__note" data-field="note"></span>
			<span class="flink__actions">
				<button class="btn btn--outline flink__button" type="button" data-action="edit">{text.edit}</button>
				<button class="btn btn--outline flink__button" type="button" data-action="delete">{text.delete}</button>
			</span>
		</li>
	</template>
</Layout>

<script>
	import { api, portalPages, fileDownloadUrl } from '../lib/api';
	import { copy, errorMessage } from '../lib/portal-copy';
	import { showState, portalIsAvailable } from '../lib/portal-ui';

	interface Item {
		id: number;
		kind: string;
		title: string;
		url: string | null;
		file: { name: string; size: number } | null;
		visibleFrom: string | null;
	}
	interface Course { id: number; code: string; title: string; semester: string; studentCount: number; resources: Item[] }

	// Same limit as the API (MAX_UPLOAD_MB). Checked here only so a too-large
	// file is refused before it is read and sent; the API checks again.
	const MAX_FILE_BYTES = 20 * 1024 * 1024;

	const text = copy.faculty;
	const list = document.getElementById('course-list')!;
	const courseTemplate = document.getElementById('course-template') as HTMLTemplateElement;
	const itemTemplate = document.getElementById('item-template') as HTMLTemplateElement;

	const field = (root: ParentNode, name: string) => root.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
	const input = (form: HTMLFormElement, name: string) => form.elements.namedItem(name) as HTMLInputElement;
	const isNote = (item: Item) => item.kind !== 'class_link'; // 'notes', and older 'other' items

	function setStatus(courseElement: Element, message: string, isError = false) {
		const status = field(courseElement, 'status');
		status.textContent = message;
		status.classList.toggle('portal-message--error', isError);
		status.hidden = !message;
	}

	function formatSize(bytes: number) {
		return bytes < 1024 * 1024 ? `${Math.max(1, Math.round(bytes / 1024))} KB` : `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
	}

	// Puts a form back into "add new" mode.
	function resetForm(form: HTMLFormElement) {
		form.reset();
		input(form, 'id').value = '';
		delete form.dataset.hasFile;
		const submit = field(form, 'submit');
		submit.textContent = submit.dataset.addLabel!;
		form.querySelector<HTMLElement>('[data-action="cancel"]')!.hidden = true;
		const currentFile = form.querySelector<HTMLElement>('[data-field="currentFile"]');
		if (currentFile) currentFile.hidden = true;
	}

	function startEditing(form: HTMLFormElement, item: Item) {
		resetForm(form);
		input(form, 'id').value = String(item.id);
		input(form, 'title').value = item.title;
		input(form, 'url').value = item.url ?? '';
		input(form, 'visibleFrom').value = item.visibleFrom ? item.visibleFrom.slice(0, 10) : '';
		const currentFile = form.querySelector<HTMLElement>('[data-field="currentFile"]');
		if (currentFile && item.file) {
			currentFile.textContent = `${text.currentFile} ${item.file.name}`;
			currentFile.hidden = false;
			form.dataset.hasFile = 'yes';
		}
		field(form, 'submit').textContent = text.save;
		form.querySelector<HTMLElement>('[data-action="cancel"]')!.hidden = false;
		input(form, 'title').focus();
	}

	// One class link or note: its title (a link if it has a URL), a download
	// link if it has a file, the show-from date, and Edit/Delete.
	function renderItem(course: Course, item: Item, form: HTMLFormElement): HTMLElement {
		const row = (itemTemplate.content.cloneNode(true) as DocumentFragment).firstElementChild as HTMLElement;
		if (item.url) {
			const link = field(row, 'link') as HTMLAnchorElement;
			link.href = item.url; // the API only stores http(s) links
			link.textContent = item.title;
			link.hidden = false;
			field(row, 'title').hidden = true;
		} else {
			field(row, 'title').textContent = item.title;
		}
		if (item.file) {
			const file = field(row, 'file') as HTMLAnchorElement;
			file.href = fileDownloadUrl(item.id);
			file.textContent = `${text.download}: ${item.file.name} (${formatSize(item.file.size)})`;
			file.hidden = false;
		}
		field(row, 'note').textContent = item.visibleFrom ? `${text.visibleFromNote} ${item.visibleFrom.slice(0, 10)}` : '';
		row.querySelector('[data-action="edit"]')!.addEventListener('click', () => startEditing(form, item));
		row.querySelector('[data-action="delete"]')!.addEventListener('click', () => deleteItem(course.id, item));
		return row;
	}

	function renderCourse(course: Course): HTMLElement {
		const element = (courseTemplate.content.cloneNode(true) as DocumentFragment).firstElementChild as HTMLElement;
		element.dataset.courseId = String(course.id);
		field(element, 'title').textContent = `${course.code} — ${course.title}`;
		field(element, 'students').textContent = course.studentCount ? `${text.students} ${course.studentCount}` : text.noStudents;

		const linkForm = element.querySelector<HTMLFormElement>('[data-form="link"]')!;
		const noteForm = element.querySelector<HTMLFormElement>('[data-form="note"]')!;
		const links = course.resources.filter((item) => !isNote(item));
		const notes = course.resources.filter(isNote);
		field(element, 'noLinks').hidden = links.length > 0;
		field(element, 'noNotes').hidden = notes.length > 0;
		field(element, 'links').append(...links.map((item) => renderItem(course, item, linkForm)));
		field(element, 'notes').append(...notes.map((item) => renderItem(course, item, noteForm)));

		for (const form of [linkForm, noteForm]) {
			form.querySelector('[data-action="cancel"]')!.addEventListener('click', () => resetForm(form));
		}
		linkForm.addEventListener('submit', (event) => {
			event.preventDefault();
			saveLink(course.id, linkForm);
		});
		noteForm.addEventListener('submit', (event) => {
			event.preventDefault();
			saveNote(course.id, noteForm);
		});
		return element;
	}

	// Reloads every course and, optionally, shows a message on one of them.
	async function load(message?: { courseId: number; text: string; isError?: boolean }) {
		const result = await api<{ courses: Course[] }>('teaching');
		if (result.error === 'unavailable') return showState('unavailable');
		if (result.error === 'not_logged_in') return showState('not-logged-in');
		if (!result.ok) return showState('not-logged-in');
		if (result.data!.courses.length === 0) return showState('empty');

		list.replaceChildren(...result.data!.courses.map(renderCourse));
		showState('courses');
		if (message) {
			const element = list.querySelector(`[data-course-id="${message.courseId}"]`);
			if (element) setStatus(element, message.text, message.isError);
		}
	}

	// Sends a form's request with its button disabled; on success reloads and shows doneText.
	async function send(courseId: number, form: HTMLFormElement, request: () => Promise<{ ok: boolean; error?: string }>, doneText: string) {
		const button = field(form, 'submit') as HTMLButtonElement;
		button.disabled = true;
		const result = await request();
		button.disabled = false;
		if (result.error === 'unavailable') return showState('unavailable');
		if (!result.ok) return setStatus(form.closest('.fcourse')!, errorMessage(result.error!), true);
		await load({ courseId, text: doneText });
	}

	function saveLink(courseId: number, form: HTMLFormElement) {
		const id = input(form, 'id').value;
		const body = { title: input(form, 'title').value, url: input(form, 'url').value, visibleFrom: input(form, 'visibleFrom').value || null };
		return send(
			courseId,
			form,
			() => (id ? api(`resources/${id}`, { method: 'PUT', body }) : api('resources', { method: 'POST', body: { courseId, ...body } })),
			id ? text.saved : text.added,
		);
	}

	// The chosen file as { name, data } with its bytes base64-encoded (the API takes JSON only).
	function readFile(file: File): Promise<{ name: string; data: string }> {
		return new Promise((resolve, reject) => {
			const reader = new FileReader();
			reader.onload = () => resolve({ name: file.name, data: String(reader.result).split(',')[1] ?? '' });
			reader.onerror = () => reject(reader.error);
			reader.readAsDataURL(file);
		});
	}

	// Without a newly chosen file, an edited note keeps the file it has.
	async function saveNote(courseId: number, form: HTMLFormElement) {
		const courseElement = form.closest('.fcourse')!;
		const id = input(form, 'id').value;
		const chosen = input(form, 'file').files?.[0];
		if (chosen && chosen.size > MAX_FILE_BYTES) return setStatus(courseElement, errorMessage('file_too_large'), true);
		if (chosen && form.dataset.hasFile && !confirm(text.confirmReplaceFile)) return;

		const body: Record<string, unknown> = {
			title: input(form, 'title').value,
			url: input(form, 'url').value || null,
			visibleFrom: input(form, 'visibleFrom').value || null,
		};
		if (chosen) {
			setStatus(courseElement, text.uploading);
			try {
				body.file = await readFile(chosen);
			} catch {
				return setStatus(courseElement, errorMessage('invalid_file'), true);
			}
		}
		return send(
			courseId,
			form,
			() => (id ? api(`notes/${id}`, { method: 'PUT', body }) : api('notes', { method: 'POST', body: { courseId, ...body } })),
			id ? text.saved : text.noteAdded,
		);
	}

	async function deleteItem(courseId: number, item: Item) {
		const note = isNote(item);
		if (!confirm(note ? text.confirmDeleteNote : text.confirmDelete)) return;
		const result = await api(`${note ? 'notes' : 'resources'}/${item.id}`, { method: 'DELETE' });
		if (result.error === 'unavailable') return showState('unavailable');
		if (!result.ok) return load({ courseId, text: errorMessage(result.error!), isError: true });
		await load({ courseId, text: note ? text.noteDeleted : text.deleted });
	}

	document.getElementById('logout-button')!.addEventListener('click', async () => {
		await api('logout', { method: 'POST' });
		location.href = portalPages.login;
	});

	async function start() {
		if (!(await portalIsAvailable())) return;
		const me = await api<{ user: { name: string; role: string; status: string; mustChangePassword: boolean } }>('me');
		if (!me.ok) return showState('not-logged-in');
		if (me.data!.user.mustChangePassword) return void (location.href = portalPages.changePassword);
		if (me.data!.user.role === 'student') return void (location.href = portalPages.portal);

		document.getElementById('portal-name')!.textContent = me.data!.user.name;
		document.getElementById('portal-account')!.hidden = false;
		if (me.data!.user.status === 'pending') return showState('pending');
		await load();
	}
	start();
</script>

<style>
	.portal-account {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		max-width: 52rem;
		margin: 0 auto var(--space-md);
	}

	.portal-account p {
		margin: 0;
	}

	section :global(.portal-panel) {
		max-width: 52rem;
	}

	.fcourse-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-lg);
	}

	:global(.fcourse) {
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}

	:global(.fcourse__title) {
		font-size: 1.3rem;
		margin-bottom: 0.2rem;
	}

	:global(.fcourse__heading) {
		font-size: 1.05rem;
		margin: var(--space-md) 0 var(--space-sm);
	}

	:global(.fcourse__meta),
	:global(.fcourse__none) {
		margin: 0 0 var(--space-sm);
		color: var(--color-text-muted);
	}

	:global(.fcourse__links) {
		list-style: none;
		margin: 0 0 var(--space-md);
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}

	:global(.flink) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.75rem;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	:global(.flink__file) {
		font-size: 0.92rem;
	}

	:global(.flink__note) {
		font-size: 0.88rem;
		color: var(--color-text-muted);
	}

	:global(.flink__actions) {
		display: flex;
		gap: 0.4rem;
		margin-left: auto;
	}

	:global(.flink__button) {
		min-height: 2.4rem;
		padding: 0.35rem 0.9rem;
		font-size: 0.9rem;
	}

	:global(.fcourse__form) {
		padding: var(--space-md);
		border-radius: var(--radius-sm);
		background: var(--color-bg-soft);
	}

	:global(.fcourse__form .btn) {
		width: auto;
	}

	:global(label.portal-field) {
		font-weight: 600;
		color: var(--navy);
	}

	:global(label.portal-field input),
	:global(label.portal-field select) {
		font-weight: 400;
	}

	:global(.portal-field select) {
		width: 100%;
		min-height: 2.9rem;
		padding: 0.6rem 0.85rem;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-sm);
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
	}

	:global(label.portal-field .portal-field__hint) {
		font-weight: 400;
	}

	.forward-reminder {
		margin-bottom: var(--space-md);
	}
</style>
