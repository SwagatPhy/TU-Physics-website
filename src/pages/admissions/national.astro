---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="National Admissions" description="Admissions information for national students at the Department of Physics.">
	<header class="page-header">
		<div class="container">
			<h1>National Admissions</h1>
			<p>Information and guidelines for Indian students applying to the Department of Physics.</p>
		</div>
	</header>

	<!-- Admissions Type Navigation -->
	<nav class="admissions-nav">
		<div class="container">
			<ul class="nav-tabs">
				<li>
					<a href="/admissions/national" class="nav-tab active">National</a>
				</li>
				<li>
					<a href="/admissions/international" class="nav-tab">International</a>
				</li>
			</ul>
		</div>
	</nav>

	<section class="section">
		<div class="container">
			<!-- Eligibility Section -->
			<section class="admissions-section">
				<h2>Eligibility Requirements</h2>

				<div class="program-group">
					<h3>B.Sc. Physics (Honours)</h3>
					<ul>
						<li><span class="placeholder">[PLACEHOLDER]</span> 10+2 / Higher Secondary with Physics, Chemistry, Mathematics</li>
						<li><span class="placeholder">[PLACEHOLDER]</span> Minimum marks / CGPA requirement</li>
						<li><span class="placeholder">[PLACEHOLDER]</span> Merit or entrance-based admission criteria</li>
					</ul>
				</div>

				<div class="program-group">
					<h3>M.Sc. Physics</h3>
					<ul>
						<li><span class="placeholder">[PLACEHOLDER]</span> B.Sc. with Physics as major/honours subject</li>
						<li><span class="placeholder">[PLACEHOLDER]</span> Minimum cumulative GPA</li>
						<li><span class="placeholder">[PLACEHOLDER]</span> Entrance exam or merit-based selection</li>
					</ul>
				</div>

				<div class="program-group">
					<h3>Ph.D. in Physics</h3>
					<ul>
						<li><span class="placeholder">[PLACEHOLDER]</span> M.Sc. in Physics or related subject</li>
						<li><span class="placeholder">[PLACEHOLDER]</span> Qualifying score: NET (UGC/CSIR), GATE, JEST, or department entrance exam</li>
						<li><span class="placeholder">[PLACEHOLDER]</span> Minimum M.Sc. marks / GPA</li>
						<li><span class="placeholder">[PLACEHOLDER]</span> Research proposal or area of interest (if required)</li>
					</ul>
				</div>
			</section>

			<!-- Application Timeline -->
			<section class="admissions-section">
				<h2>Application Timeline & Key Dates</h2>
				<p class="note">Academic Year <span class="placeholder">[PLACEHOLDER YYYY-YYYY]</span></p>

				<div class="timeline">
					<div class="timeline-item">
						<strong>Application Window Opens:</strong>
						<span class="placeholder">[PLACEHOLDER Month, DD]</span>
					</div>
					<div class="timeline-item">
						<strong>Application Deadline:</strong>
						<span class="placeholder">[PLACEHOLDER Month, DD]</span>
					</div>
					<div class="timeline-item">
						<strong>Entrance Exam Date:</strong>
						<span class="placeholder">[PLACEHOLDER Month, DD]</span> (if applicable)
					</div>
					<div class="timeline-item">
						<strong>Result Announcement:</strong>
						<span class="placeholder">[PLACEHOLDER Month, DD]</span>
					</div>
					<div class="timeline-item">
						<strong>Merit List & Counseling:</strong>
						<span class="placeholder">[PLACEHOLDER Month, DD]</span>
					</div>
					<div class="timeline-item">
						<strong>Semester Start:</strong>
						<span class="placeholder">[PLACEHOLDER Month, DD]</span>
					</div>
				</div>
			</section>

			<!-- How to Apply -->
			<section class="admissions-section">
				<h2>How to Apply</h2>
				<ol class="steps">
					<li>Visit the <strong><span class="placeholder">[PLACEHOLDER Tezpur University Admissions Portal]</span></strong></li>
					<li>Register and fill the application form</li>
					<li>Upload required documents (see checklist below)</li>
					<li>Pay application fee: <span class="placeholder">[PLACEHOLDER amount in INR]</span></li>
					<li>Submit and save confirmation receipt</li>
				</ol>

				<div class="programs-offered">
					<h3>Programs Offered</h3>
					<ul>
						<li>B.Sc. Physics (Honours) — <span class="placeholder">[PLACEHOLDER XX seats]</span></li>
						<li>M.Sc. Physics — <span class="placeholder">[PLACEHOLDER XX seats]</span></li>
						<li>Ph.D. Physics — Rolling admissions year-round</li>
					</ul>
				</div>
			</section>

			<!-- Required Documents -->
			<section class="admissions-section">
				<h2>Required Documents</h2>

				<div class="doc-group">
					<h3>All Programs</h3>
					<ul>
						<li><span class="placeholder">[PLACEHOLDER]</span> Valid photo ID (Aadhaar, Passport, PAN, or Voter ID)</li>
						<li><span class="placeholder">[PLACEHOLDER]</span> Recent passport-sized photograph (4x6 cm)</li>
						<li><span class="placeholder">[PLACEHOLDER]</span> Official academic transcript(s) from previous qualification</li>
						<li><span class="placeholder">[PLACEHOLDER]</span> Proof of category/caste (if applicable — SC/ST/OBC/PWD)</li>
					</ul>
				</div>

				<div class="doc-group">
					<h3>M.Sc. / Ph.D.</h3>
					<ul>
						<li><span class="placeholder">[PLACEHOLDER]</span> Bachelor's/Master's degree certificate (provisional if exam is pending)</li>
						<li><span class="placeholder">[PLACEHOLDER]</span> Rank card or merit certificate (if entrance-based)</li>
						<li><span class="placeholder">[PLACEHOLDER]</span> Statement of Purpose / Research Interest (for PhD)</li>
					</ul>
				</div>
			</section>

			<!-- Fees & Scholarships -->
			<section class="admissions-section">
				<h2>Fees & Scholarships</h2>

				<div class="fees-group">
					<h3>Tuition Fees (per semester)</h3>
					<ul>
						<li>B.Sc. Physics: <span class="placeholder">[PLACEHOLDER ₹XXXX]</span></li>
						<li>M.Sc. Physics: <span class="placeholder">[PLACEHOLDER ₹XXXX]</span></li>
						<li>Ph.D. Physics: <span class="placeholder">[PLACEHOLDER ₹XXXX]</span> (or fellowship amount, if available)</li>
					</ul>
				</div>

				<div class="scholarships-group">
					<h3>Financial Support Available</h3>
					<ul>
						<li><strong>UGC National Scholarship:</strong> <span class="placeholder">[PLACEHOLDER eligibility/amount]</span></li>
						<li><strong>CSIR Fellowship:</strong> <span class="placeholder">[PLACEHOLDER]</span> Available for PhD</li>
						<li><strong>INSPIRE Scholarship:</strong> <span class="placeholder">[PLACEHOLDER eligibility]</span></li>
						<li><strong>Institute Fellowships:</strong> <span class="placeholder">[PLACEHOLDER ₹XXXX/month for PhD scholars]</span></li>
						<li><strong>Departmental Scholarships:</strong> <span class="placeholder">[PLACEHOLDER]</span> Merit-based or need-based</li>
					</ul>
					<p class="contact-note">For more details: Contact the Financial Aid Office at <span class="placeholder">[PLACEHOLDER email]</span></p>
				</div>
			</section>

			<!-- Contact & Support -->
			<section class="admissions-section">
				<h2>Contact & Support</h2>

				<div class="contact-box">
					<h3>Admissions Coordinator (National Programs)</h3>
					<ul class="contact-list">
						<li><strong>Email:</strong> <span class="placeholder">[PLACEHOLDER admissions@tezu.ac.in]</span></li>
						<li><strong>Phone:</strong> <span class="placeholder">[PLACEHOLDER +91-XXXX-XXXXXX]</span></li>
						<li><strong>Office:</strong> <span class="placeholder">[PLACEHOLDER Department of Physics, Building/Block]</span></li>
						<li><strong>Office Hours:</strong> <span class="placeholder">[PLACEHOLDER Mon–Fri, 10:00 AM – 4:00 PM]</span></li>
					</ul>
					<p>Send an email or visit during office hours with questions about eligibility, application status, or program details.</p>
				</div>
			</section>

			<!-- FAQs -->
			<section class="admissions-section">
				<h2>Frequently Asked Questions</h2>

				<div class="faq-item">
					<strong>Q: Can I apply if my entrance exam (GATE/NET/JEST) is pending?</strong>
					<p>A: <span class="placeholder">[PLACEHOLDER]</span> Check with admissions coordinator; typically provisional admission may be offered pending final scores.</p>
				</div>

				<div class="faq-item">
					<strong>Q: What is the typical timeline from application to enrollment?</strong>
					<p>A: <span class="placeholder">[PLACEHOLDER]</span> Typically 2–3 months from application deadline to semester start, subject to examination schedules.</p>
				</div>

				<div class="faq-item">
					<strong>Q: Are there deferred admission options if I can't join in the current semester?</strong>
					<p>A: <span class="placeholder">[PLACEHOLDER]</span> Refer to the Tezpur University admissions policy; check with the admissions office.</p>
				</div>

				<div class="faq-item">
					<strong>Q: Do I need to be a resident of Assam to apply?</strong>
					<p>A: <span class="placeholder">[PLACEHOLDER]</span> No; central universities in India admit from across the country. However, there may be reserved seats for state candidates per university policy.</p>
				</div>
			</section>
		</div>
	</section>

	<style>
		.admissions-nav {
			border-bottom: 1px solid var(--color-border);
			background: var(--color-bg-alt, #fafafa);
		}

		.nav-tabs {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			gap: 1rem;
		}

		.nav-tab {
			display: block;
			padding: 1rem 1.5rem;
			text-decoration: none;
			color: var(--color-text-muted);
			border-bottom: 2px solid transparent;
			transition: all 0.2s ease;
			font-weight: 500;
		}

		.nav-tab:hover {
			color: var(--color-text);
		}

		.nav-tab.active {
			color: var(--color-accent);
			border-bottom-color: var(--color-accent);
		}

		.admissions-section {
			margin-bottom: 2.5rem;
		}

		.admissions-section h2 {
			font-size: 1.4rem;
			margin-bottom: 1rem;
			color: var(--color-text);
		}

		.content-placeholder {
			padding: 2rem;
			background: var(--color-bg-alt, #fafafa);
			border: 1px dashed var(--color-border);
			border-radius: 0.5rem;
			color: var(--color-text-muted);
			text-align: center;
			font-style: italic;
			min-height: 5rem;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.placeholder {
			background-color: #fef3cd;
			padding: 2px 6px;
			border-radius: 3px;
			font-style: italic;
			color: #856404;
		}

		.program-group {
			margin-bottom: 2rem;
		}

		.program-group h3 {
			font-size: 1.1rem;
			margin-top: 1.5rem;
			margin-bottom: 0.75rem;
			color: var(--color-text);
		}

		.program-group:first-child h3 {
			margin-top: 0;
		}

		.program-group ul {
			margin: 0;
			padding-left: 1.5rem;
		}

		.program-group li {
			margin-bottom: 0.5rem;
			line-height: 1.6;
		}

		.timeline {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 1rem;
			margin: 1.5rem 0;
		}

		.timeline-item {
			padding: 1rem;
			background: var(--color-bg-alt, #fafafa);
			border: 1px solid var(--color-border);
			border-radius: 0.5rem;
		}

		.timeline-item strong {
			display: block;
			margin-bottom: 0.5rem;
		}

		.note {
			font-size: 0.95rem;
			color: var(--color-text-muted);
			margin-bottom: 1.5rem;
		}

		.steps {
			margin: 1rem 0;
			padding-left: 1.75rem;
		}

		.steps li {
			margin-bottom: 0.75rem;
			line-height: 1.6;
		}

		.programs-offered {
			margin-top: 1.5rem;
			padding: 1.25rem;
			background: var(--color-bg-alt, #fafafa);
			border-radius: 0.5rem;
		}

		.programs-offered h3 {
			font-size: 1rem;
			margin-top: 0;
			margin-bottom: 0.75rem;
		}

		.programs-offered ul {
			margin: 0;
			padding-left: 1.5rem;
		}

		.programs-offered li {
			margin-bottom: 0.5rem;
		}

		.doc-group {
			margin-bottom: 1.5rem;
		}

		.doc-group h3 {
			font-size: 1rem;
			margin-bottom: 0.75rem;
		}

		.doc-group ul {
			margin: 0;
			padding-left: 1.5rem;
		}

		.doc-group li {
			margin-bottom: 0.5rem;
			line-height: 1.6;
		}

		.fees-group,
		.scholarships-group {
			margin-bottom: 1.5rem;
		}

		.fees-group h3,
		.scholarships-group h3 {
			font-size: 1.05rem;
			margin-top: 0;
			margin-bottom: 0.75rem;
		}

		.fees-group ul,
		.scholarships-group ul {
			margin: 0;
			padding-left: 1.5rem;
		}

		.fees-group li,
		.scholarships-group li {
			margin-bottom: 0.5rem;
		}

		.contact-note {
			margin-top: 1rem;
			font-size: 0.95rem;
		}

		.contact-box {
			padding: 1.5rem;
			background: var(--color-bg-alt, #fafafa);
			border: 1px solid var(--color-border);
			border-radius: 0.5rem;
		}

		.contact-box h3 {
			margin-top: 0;
			font-size: 1.05rem;
		}

		.contact-list {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		.contact-list li {
			margin-bottom: 0.5rem;
		}

		.faq-item {
			margin-bottom: 1.5rem;
		}

		.faq-item strong {
			display: block;
			margin-bottom: 0.5rem;
			color: var(--color-text);
		}

		.faq-item p {
			margin: 0;
			line-height: 1.6;
		}
	</style>
</Layout>
