---
import BaseLayout from '../layouts/BaseLayout.astro';

const notices = [
  { date: '[PLACEHOLDER Month DD, YYYY]', title: '[PLACEHOLDER] M.Sc. Physics Semester Exam Schedule' },
  { date: '[PLACEHOLDER Month DD, YYYY]', title: '[PLACEHOLDER] PhD Entrance Test Result Notification' },
];

const events = [
  {
    title: '[PLACEHOLDER Departmental Seminar Series]: "[PLACEHOLDER talk title]"',
    speaker: '[PLACEHOLDER Name], [PLACEHOLDER affiliation]',
    when: '[PLACEHOLDER Day, Date, Time]',
    venue: '[PLACEHOLDER — Room / Building / virtual link]',
  },
];
---

<BaseLayout title="Notices & Events">
  <section class="hero">
    <div class="container">
      <h1>Notices &amp; Events</h1>
      <p class="lede">
        Departmental notices &mdash; admissions, exam schedules, results
        &mdash; and upcoming seminars, colloquia, and workshops.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="placeholder-note">
        Notices and events below are [PLACEHOLDER] pending real content
        from the department's notice archive and seminar calendar.
      </div>
      <h2>Notices</h2>
      <table class="simple-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Notice</th>
          </tr>
        </thead>
        <tbody>
          {notices.map((n) => (
            <tr>
              <td>{n.date}</td>
              <td>{n.title}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Upcoming Events</h2>
      <div class="card-grid">
        {events.map((e) => (
          <div class="card">
            <h3>{e.title}</h3>
            <p><strong>Speaker:</strong> {e.speaker}</p>
            <p><strong>When:</strong> {e.when}</p>
            <p><strong>Venue:</strong> {e.venue}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
