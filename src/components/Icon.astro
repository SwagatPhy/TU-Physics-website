const { name, class: className = '' } = Astro.props;
---

<svg
	class={`icon ${className}`}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={paths[name]}
