---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { formatDate } from '../lib/date';
import { researchImage } from '../lib/images';

// Headline numbers are counted from the content collections, so they stay
// correct as people and research areas are added.
const teaching = await getCollection('teaching');
const scholars = await getCollection('researchScholars');
const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const programs = (await getCollection('admissions')).sort((a, b) => a.data.order - b.data.order);

const newsEvents = (await getCollection('newsEvents', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const news = newsEvents.filter((item) => item.data.type === 'news').slice(0, 3);
const events = newsEvents.filter((item) => item.data.type === 'event').slice(0, 3);

const stats = [
	{ value: teaching.length, label: 'Faculty members' },
	{ value: scholars.length, label: 'Research scholars' },
	{ value: research.length, label: 'Research areas' },
	{ value: programs.length, label: 'Degree programs' },
];

// Visitor counter: set this to a URL that returns JSON like {"count": 1234}
// to show a live count. While empty, the counter shows a dash.
const VISITOR_COUNTER_URL = '';
---

<Layout title="Home" description="Official website of the Department of Physics, Tezpur University.">
	<!-- Hero -->
	<section class="hero">
		<img
			class="hero__image"
			src="/Dept-photos/web/dept_pho1.jpg"
			alt="The Department of Physics building, Tezpur University"
			fetchpriority="high"
		/>
		<div class="container hero__content">
			<p class="eyebrow">Tezpur University</p>
			<h1>Department of Physics</h1>
			<p class="hero__lead">
				The Department of Physics has stridden out not only in its post-graduation teaching but also in new
				frontiers of research since its commencement in January 1998.
			</p>
			<div class="btn-row">
				<a class="btn btn--primary" href="/research">Explore research <Icon name="arrow-right" /></a>
				<a class="btn btn--on-dark" href="/admissions">Admissions</a>
				<a class="btn btn--on-dark" href="/about">About the department</a>
			</div>
		</div>

		<!-- Clock and visitor counter (DESIGN.md) -->
		<div class="container">
			<dl class="hero__info" data-counter-url={VISITOR_COUNTER_URL}>
				<div>
					<dt><Icon name="clock" /> Tezpur (IST)</dt>
					<dd><time id="clock-time">--:--</time> <span id="clock-date" class="hero__info-sub"></span></dd>
				</div>
				<div>
					<dt><Icon name="eye" /> Visitors</dt>
					<dd id="visitor-count">&mdash;</dd>
				</div>
			</dl>
		</div>
	</section>

	<!-- At a glance -->
	<section class="section section--tight">
		<div class="container intro">
			<div>
				<p class="eyebrow">At a glance</p>
				<p class="intro__text justify">
					The department offers a two-year M.Sc. course in Physics alongside an Integrated M.Sc. course, with
					dual specialization at post-graduation in Condensed Matter Physics,
					Nanoscience &amp; Technology, High Energy Physics, Electronics, Photonics, Plasma Physics and
					Astrophysics.
				</p>
				<a class="link-arrow" href="/about">More about the department <Icon name="arrow-right" /></a>
			</div>
			<ul class="stats">
				{stats.map((stat) => (
					<li class="stat">
						<span class="stat__value">{stat.value}</span>
						<span class="stat__label">{stat.label}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- Programs -->
	<section class="section section--soft">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">Study with us</p>
					<h2>Programs</h2>
				</div>
				<a class="link-arrow" href="/admissions">Admissions <Icon name="arrow-right" /></a>
			</div>
			<ul class="grid grid--fill">
				{programs.map((program, i) => (
					<li>
						<a class="card program-card" href={`/admissions/${program.id}`}>
							<div class="card__body">
								<span class="program-card__index">0{i + 1}</span>
								<h3 class="card__title">{program.data.title}</h3>
								<p class="card__text">{program.data.tagline}</p>
								<span class="card__footer link-arrow">View program <Icon name="arrow-right" /></span>
							</div>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- Research areas -->
	<section class="section">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">Research</p>
					<h2>Areas of research</h2>
				</div>
				<a class="link-arrow" href="/research">All {research.length} research areas <Icon name="arrow-right" /></a>
			</div>
			<ul class={`grid research-mosaic ${research.length % 2 === 1 ? 'research-mosaic--odd' : ''}`}>
				{research.map((item) => (
					<li>
						<a class={`research-tile ${item.data.image ? '' : 'plain-art'}`} href={`/research/${item.id}`}>
							{item.data.image && (
								<img src={researchImage(item.data.image)} alt="" loading="lazy" decoding="async" />
							)}
							<span class="research-tile__label">{item.data.specialization}</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- Observatory feature -->
	<section class="section section--navy">
		<div class="container split">
			<div class="feature-photos">
				<img
					class="feature-photos__main"
					src="/Facilities-photos/Resources/web/Dome.jpg"
					alt="The Tezpur University Observatory dome on a rooftop"
					loading="lazy"
				/>
				<img
					class="feature-photos__inset"
					src="/Facilities-photos/Resources/web/Telescope.jpg"
					alt="The observatory telescope inside the dome"
					loading="lazy"
				/>
			</div>
			<div>
				<p class="eyebrow">Facilities</p>
				<h2>Tezpur University Observatory</h2>
				<p>
					Alongside its teaching and research laboratories, the department's facilities include the Tezpur
					University Observatory.
				</p>
				<div class="btn-row">
					<a class="btn btn--primary" href="/facilities">See the facilities <Icon name="arrow-right" /></a>
				</div>
			</div>
		</div>
	</section>

	<!-- News and events -->
	<section class="section">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">What's happening</p>
					<h2>News &amp; events</h2>
				</div>
				<a class="link-arrow" href="/news-events">All news &amp; events <Icon name="arrow-right" /></a>
			</div>

			<div class="news-layout">
				<div>
					<h3 class="column-title">Latest news</h3>
					{news.length === 0 && <p class="text-muted">No news items at the moment.</p>}
					<ul class="news-list">
						{news.map((item) => (
							<li>
								<article class="news-item">
									<time class="news-item__date" datetime={item.data.date.toISOString()}>
										{formatDate(item.data.date)}
									</time>
									<h4><a href={`/news-events/${item.id}`}>{item.data.title}</a></h4>
									<p>{item.data.summary}</p>
								</article>
							</li>
						))}
					</ul>
				</div>

				<div>
					<h3 class="column-title">Events</h3>
					{events.length === 0 && <p class="text-muted">No events at the moment.</p>}
					<ul class="news-list">
						{events.map((item) => (
							<li>
								<article class="event-item">
									<div class="event-item__date" aria-hidden="true">
										<span class="event-item__day">{item.data.date.getUTCDate()}</span>
										<span class="event-item__month">
											{item.data.date.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' })}
										</span>
									</div>
									<div>
										<h4><a href={`/news-events/${item.id}`}>{item.data.title}</a></h4>
										<p class="event-item__meta">
											<span class="visually-hidden">{formatDate(item.data.date)} · </span>
											{item.data.location}
										</p>
									</div>
								</article>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Admissions call to action -->
	<section class="section section--tight">
		<div class="container">
			<div class="cta-band">
				<div>
					<h2>Ready to join us?</h2>
					<p>Explore our admissions process and start your physics journey with us.</p>
				</div>
				<div class="btn-row">
					<a class="btn btn--primary" href="/admissions">View admissions <Icon name="arrow-right" /></a>
					<a class="btn btn--on-dark" href="/contact">Contact the department</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	// Live clock in India Standard Time.
	const timeEl = document.getElementById('clock-time');
	const dateEl = document.getElementById('clock-date');
	const timeFormat = new Intl.DateTimeFormat('en-IN', {
		hour: 'numeric',
		minute: '2-digit',
		second: '2-digit',
		hour12: true,
		timeZone: 'Asia/Kolkata',
	});
	const dateFormat = new Intl.DateTimeFormat('en-IN', {
		weekday: 'short',
		day: 'numeric',
		month: 'short',
		timeZone: 'Asia/Kolkata',
	});

	function updateClock() {
		const now = new Date();
		if (timeEl) timeEl.textContent = timeFormat.format(now);
		if (dateEl) dateEl.textContent = dateFormat.format(now);
	}

	updateClock();
	setInterval(updateClock, 1000);

	// Visitor counter: only runs once a counter URL is configured in index.astro.
	const counterUrl = document.querySelector<HTMLElement>('.hero__info')?.dataset.counterUrl;
	const countEl = document.getElementById('visitor-count');
	if (counterUrl && countEl) {
		fetch(counterUrl)
			.then((response) => response.json())
			.then((data) => {
				if (typeof data.count === 'number') countEl.textContent = data.count.toLocaleString('en-IN');
			})
			.catch(() => {
				/* leave the dash in place */
			});
	}
</script>

<style>
	/* Hero ------------------------------------------------------------------ */
	.hero {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: min(88vh, 52rem);
		padding-top: var(--space-xl);
		color: var(--color-on-dark);
		background: var(--navy);
		overflow: hidden;
	}

	.hero__image {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 40%;
	}

	.hero::before {
		/* navy wash so white text stays readable over the photo */
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(90deg, rgba(0, 37, 78, 0.9) 0%, rgba(0, 37, 78, 0.6) 45%, rgba(0, 37, 78, 0.05) 100%),
			linear-gradient(0deg, rgba(0, 37, 78, 0.7) 0%, transparent 35%);
	}

	.hero__content {
		padding-bottom: var(--space-lg);
	}

	.hero .eyebrow {
		color: var(--ice);
	}

	.hero h1 {
		color: var(--color-on-dark);
		font-size: clamp(2.6rem, 1.8rem + 4vw, 4.75rem);
		max-width: 12ch;
		margin-bottom: var(--space-md);
	}

	.hero__lead {
		max-width: 36rem;
		font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem);
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: var(--space-lg);
	}

	.hero__info {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm) var(--space-lg);
		margin: 0 0 var(--space-md);
		padding: var(--space-sm) var(--space-md);
		width: fit-content;
		max-width: 100%;
		border: 1px solid rgba(199, 220, 229, 0.25);
		border-radius: var(--radius);
		background: rgba(0, 37, 78, 0.55);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.hero__info dt {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ice);
	}

	.hero__info dd {
		margin: 0.1rem 0 0;
		font-variant-numeric: tabular-nums;
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--color-on-dark);
	}

	.hero__info-sub {
		margin-left: 0.4rem;
		font-size: 0.9rem;
		font-weight: 400;
		color: var(--ice);
	}

	/* At a glance ------------------------------------------------------------ */
	.intro {
		display: grid;
		gap: var(--space-lg);
		align-items: center;
	}

	.intro__text {
		font-family: var(--font-serif);
		font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.45rem);
		line-height: 1.55;
		color: var(--navy);
	}

	.intro .stats {
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-lg) var(--space-md);
	}

	@media (min-width: 60rem) {
		.intro {
			grid-template-columns: 1.2fr 1fr;
			gap: var(--space-xl);
		}
	}

	/* Programs --------------------------------------------------------------- */
	.program-card__index {
		font-family: var(--font-serif);
		font-size: 0.95rem;
		color: var(--slate);
		padding-bottom: 0.5rem;
		margin-bottom: 0.25rem;
		border-bottom: 2px solid var(--mint);
		width: fit-content;
	}

	/* Research mosaic -------------------------------------------------------- */
	/* 1 column on phones, 2 on tablets, 4 on desktop. With an odd number of
	   areas the first tile is double-width so the rows still fill evenly. */
	.research-mosaic {
		grid-template-columns: 1fr;
	}

	@media (min-width: 40rem) {
		.research-mosaic {
			grid-template-columns: repeat(2, 1fr);
		}

		.research-mosaic--odd > li:first-child {
			grid-column: span 2;
		}

		.research-mosaic--odd > li:first-child .research-tile {
			aspect-ratio: 16 / 7;
		}
	}

	@media (min-width: 64rem) {
		.research-mosaic {
			grid-template-columns: repeat(4, 1fr);
		}

		.research-mosaic .research-tile,
		.research-mosaic--odd > li:first-child .research-tile {
			aspect-ratio: auto;
			height: 15rem;
		}
	}

	.research-tile {
		position: relative;
		display: block;
		aspect-ratio: 4 / 3;
		border-radius: var(--radius);
		overflow: hidden;
		background-color: var(--navy); /* colour only, so .plain-art's pattern shows */
		text-decoration: none;
	}

	.research-tile img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s var(--ease);
	}

	.research-tile::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(0deg, rgba(0, 37, 78, 0.9) 0%, rgba(0, 37, 78, 0.1) 60%);
		transition: background-color 0.3s var(--ease);
	}

	.research-tile:hover img {
		transform: scale(1.05);
	}

	.research-tile__label {
		position: absolute;
		left: var(--space-md);
		right: var(--space-md);
		bottom: var(--space-md);
		z-index: 1;
		font-family: var(--font-serif);
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.25;
		color: var(--color-on-dark);
	}

	.research-tile__label::after {
		content: '';
		display: block;
		width: 2rem;
		height: 2px;
		margin-top: 0.6rem;
		background: var(--mint);
		transition: width 0.3s var(--ease);
	}

	.research-tile:hover .research-tile__label::after {
		width: 4rem;
	}

	/* Observatory feature ------------------------------------------------------ */
	.feature-photos {
		position: relative;
		padding: 0 12% 12% 0;
	}

	.feature-photos__main {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius);
	}

	.feature-photos__inset {
		position: absolute;
		right: 0;
		bottom: 0;
		width: 42%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: var(--radius);
		border: 4px solid var(--navy);
	}

	/* News & events ---------------------------------------------------------- */
	.news-layout {
		display: grid;
		gap: var(--space-lg);
	}

	@media (min-width: 56rem) {
		.news-layout {
			grid-template-columns: 1.3fr 1fr;
			gap: var(--space-xl);
		}
	}

	.column-title {
		font-family: var(--font-sans);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		padding-bottom: var(--space-sm);
		border-bottom: 1px solid var(--color-border);
	}

	.news-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.news-list li {
		padding-block: var(--space-md);
		border-bottom: 1px solid var(--color-border);
	}

	.news-list h4 {
		font-size: 1.2rem;
		margin: 0.25rem 0 0.4rem;
	}

	.news-list h4 a {
		text-decoration: none;
	}

	.news-list h4 a:hover {
		text-decoration: underline;
	}

	.news-item p {
		margin: 0;
	}

	.news-item__date {
		font-size: 0.88rem;
		color: var(--color-text-muted);
	}

	.event-item {
		display: flex;
		gap: var(--space-md);
		align-items: flex-start;
	}

	.event-item__date {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 4rem;
		height: 4rem;
		flex-shrink: 0;
		border-radius: var(--radius-sm);
		background: var(--color-bg-soft);
		border: 1px solid var(--color-border);
	}

	.event-item__day {
		font-family: var(--font-serif);
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1;
		color: var(--navy);
	}

	.event-item__month {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--slate);
	}

	.event-item__meta {
		margin: 0;
		font-size: 0.92rem;
		color: var(--color-text-muted);
	}

	/* Call to action --------------------------------------------------------- */
	.cta-band {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		padding: clamp(2rem, 1.5rem + 3vw, 4rem);
		border-radius: calc(var(--radius) * 1.5);
		color: var(--color-on-dark-muted);
		background:
			radial-gradient(circle at 100% 0%, rgba(123, 217, 176, 0.22), transparent 45%),
			linear-gradient(135deg, var(--navy) 0%, #12406f 100%);
	}

	.cta-band h2 {
		color: var(--color-on-dark);
	}

	.cta-band p {
		margin: 0;
		max-width: 34rem;
	}
</style>
