---
import BaseLayout from '../layouts/BaseLayout.astro';

// Placeholder faculty roster structure. Do NOT treat names/fields below as
// real people — they are structural stand-ins for the notes/content agent
// to replace with the actual roster.
const facultyPlaceholders = [
  { name: '[Faculty Name 1 — TODO]', title: 'Professor', area: '[Research area — TODO]' },
  { name: '[Faculty Name 2 — TODO]', title: 'Associate Professor', area: '[Research area — TODO]' },
  { name: '[Faculty Name 3 — TODO]', title: 'Assistant Professor', area: '[Research area — TODO]' },
  { name: '[Faculty Name 4 — TODO]', title: 'Emeritus Professor', area: '[Research area — TODO]' },
];
---

<BaseLayout title="Faculty">
  <section class="hero">
    <div class="container">
      <h1>Faculty</h1>
      <p class="lede">Placeholder roster &mdash; replace with the real faculty list, photos, and profile links.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="placeholder-note">
        {/* TODO: content agent to fill — real faculty roster, photos, bios, contact/profile links */}
        No real names below. Structural placeholders only.
      </div>
      <div class="card-grid">
        {facultyPlaceholders.map((f) => (
          <div class="card">
            <h3>{f.name}</h3>
            <p>{f.title}</p>
            <p>{f.area}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
