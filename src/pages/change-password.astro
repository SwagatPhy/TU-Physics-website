---
// Change password. Required on first login (seeded or reset accounts carry
// mustChangePassword); also available to anyone who is logged in.
// States: loading → unavailable | not-logged-in | form | done.
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PortalPanel from '../components/PortalPanel.astro';
import { copy } from '../lib/portal-copy';
import { portalPages } from '../lib/api';

const text = copy.changePassword;
---

<Layout title={text.title} noindex>
	<PageHeader title={text.title} crumbs={[{ label: copy.login.title, href: '/login' }]} />

	<section class="section">
		<div class="container">
			<PortalPanel>
				<div data-state="not-logged-in" hidden>
					<p>{text.notLoggedIn}</p>
					<a class="btn btn--navy" href={portalPages.login}>{text.loginLink}</a>
				</div>

				<div data-state="form" hidden>
					<p id="first-login-intro" hidden>{text.firstLoginIntro}</p>
					<p id="normal-intro" hidden>{text.intro}</p>
					<form class="portal-form" id="change-form" novalidate>
						<div class="portal-field">
							<label for="current-password">{text.currentPassword}</label>
							<input id="current-password" name="currentPassword" type="password" autocomplete="current-password" required />
						</div>
						<div class="portal-field">
							<label for="new-password">{text.newPassword}</label>
							<input id="new-password" name="newPassword" type="password" autocomplete="new-password" minlength="10" maxlength="200" required aria-describedby="password-rule" />
							<p class="portal-field__hint" id="password-rule">{text.passwordRule}</p>
						</div>
						<div class="portal-field">
							<label for="confirm-password">{text.confirmPassword}</label>
							<input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" required />
						</div>
						<button class="btn btn--navy" type="submit">{text.submit}</button>
					</form>
				</div>

				<div data-state="done" hidden>
					<p>{text.done}</p>
					<a class="btn btn--navy" href={portalPages.login}>{text.loginLink}</a>
				</div>
			</PortalPanel>
		</div>
	</section>
</Layout>

<script>
	import { api } from '../lib/api';
	import { showState, showError, portalIsAvailable, onSubmit, passwordsMatch } from '../lib/portal-ui';

	onSubmit(document.getElementById('change-form') as HTMLFormElement, async ({ currentPassword, newPassword, confirmPassword }) => {
		if (!passwordsMatch(newPassword, confirmPassword)) return;
		const result = await api('change-password', { method: 'POST', body: { currentPassword, newPassword } });
		if (result.error === 'unavailable') return showState('unavailable');
		if (result.error === 'not_logged_in') return showState('not-logged-in');
		if (!result.ok) return showError(result);
		showState('done');
	});

	async function start() {
		if (!(await portalIsAvailable())) return;
		const me = await api<{ user: { mustChangePassword: boolean } }>('me');
		if (!me.ok) return showState('not-logged-in');
		const firstLogin = me.data!.user.mustChangePassword;
		document.getElementById('first-login-intro')!.hidden = !firstLogin;
		document.getElementById('normal-intro')!.hidden = firstLogin;
		showState('form');
	}
	start();
</script>
