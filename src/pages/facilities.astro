---
import BaseLayout from '../layouts/BaseLayout.astro';

const teachingLabs = [
  { name: '[PLACEHOLDER] General Physics Laboratory', desc: 'Used for undergraduate laboratory courses covering [PLACEHOLDER topics].' },
  { name: '[PLACEHOLDER] Electronics Laboratory', desc: 'Supports coursework in [PLACEHOLDER topics] for [PLACEHOLDER program level].' },
];

const researchLabs = [
  { name: '[PLACEHOLDER Lab Name]', area: '[PLACEHOLDER — links to Research page]', faculty: '[PLACEHOLDER name]', equipment: '[PLACEHOLDER — e.g. spectrometer, deposition system]' },
  { name: '[PLACEHOLDER Lab Name]', area: '[PLACEHOLDER — links to Research page]', faculty: '[PLACEHOLDER name]', equipment: '[PLACEHOLDER equipment]' },
];

const sharedFacilities = [
  { name: '[PLACEHOLDER] Departmental Library / Reading Room', desc: '[PLACEHOLDER description]' },
  { name: '[PLACEHOLDER] Computing Facility', desc: '[PLACEHOLDER description]' },
];
---

<BaseLayout title="Facilities">
  <section class="hero">
    <div class="container">
      <h1>Facilities &amp; Laboratories</h1>
      <p class="lede">
        The Department of Physics, Tezpur University maintains a range of
        teaching and research laboratories supporting its UG, PG, and PhD
        programs.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="placeholder-note">
        Lab names, faculty in charge, and equipment lists below are
        [PLACEHOLDER] pending confirmation from the department.
      </div>
      <h2>Teaching Labs</h2>
      <div class="card-grid">
        {teachingLabs.map((lab) => (
          <div class="card">
            <h3>{lab.name}</h3>
            <p>{lab.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Research Labs</h2>
      <div class="card-grid">
        {researchLabs.map((lab) => (
          <div class="card">
            <h3>{lab.name}</h3>
            <p><strong>Research area:</strong> {lab.area}</p>
            <p><strong>Faculty in charge:</strong> {lab.faculty}</p>
            <p><strong>Major equipment:</strong> {lab.equipment}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Shared Facilities</h2>
      <div class="card-grid">
        {sharedFacilities.map((f) => (
          <div class="card">
            <h3>{f.name}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
