---
import BaseLayout from '../layouts/BaseLayout.astro';

// Overview and Mission & Vision below use content-notes/about.md's
// "current default" options. Two more overview variants and two more
// mission/vision variants (including a split mission/vision format) are
// drafted there — swap in a different one once the department picks a
// direction.
---

<BaseLayout title="About">
  <section class="hero">
    <div class="container">
      <h1>About the Department</h1>
      <p class="lede">
        One of the constituent departments of Tezpur University, offering
        undergraduate, postgraduate, and doctoral programs in Physics
        alongside active research.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="placeholder-note">
        Overview, history, and leadership copy below use [PLACEHOLDER]
        facts pending confirmation from the department &mdash; founding
        year, School/Faculty affiliation, and HoD details.
      </div>

      <h2>Overview</h2>
      <p>
        The Department of Physics is one of the constituent departments of
        Tezpur University, a central university located in Assam, India.
        Established in [PLACEHOLDER YEAR], the department offers
        undergraduate, postgraduate, and doctoral programs in Physics
        alongside active research programs.
      </p>

      <h2>History</h2>
      <ul>
        <li>[PLACEHOLDER YEAR] &mdash; Department established</li>
        <li>[PLACEHOLDER YEAR] &mdash; First M.Sc. Physics batch admitted</li>
        <li>[PLACEHOLDER YEAR] &mdash; PhD program introduced</li>
        <li>[PLACEHOLDER YEAR] &mdash; [PLACEHOLDER &mdash; e.g. Major research lab/facility set up]</li>
        <li>[PLACEHOLDER YEAR] &mdash; [PLACEHOLDER &mdash; e.g. First major sponsored research grant secured (UGC/DST/SERB)]</li>
        <li>[PLACEHOLDER YEAR] &mdash; [PLACEHOLDER &mdash; e.g. Notable alumnus/achievement/accreditation milestone]</li>
      </ul>

      <h2>Mission &amp; Vision</h2>
      <p>
        Our mission is to provide quality physics education at all levels
        and to conduct research that contributes to the advancement of the
        discipline, while fostering scientific temper among students in the
        region.
      </p>

      <h2>Leadership</h2>
      <p>
        <strong>[PLACEHOLDER NAME]</strong>, Head of Department &mdash;
        [PLACEHOLDER &mdash; one-line bio, e.g. "Prof. [Name]'s research
        interests include [area]."]
      </p>
    </div>
  </section>
</BaseLayout>
