---
import BaseLayout from '../layouts/BaseLayout.astro';

const departmentContacts = [
  { office: '[PLACEHOLDER Head of Department]', email: '[PLACEHOLDER hod.physics@tezu.ac.in]', phone: '[PLACEHOLDER phone]' },
  { office: '[PLACEHOLDER Admissions Coordinator]', email: '[PLACEHOLDER admissions.physics@tezu.ac.in]', phone: '[PLACEHOLDER phone]' },
  { office: '[PLACEHOLDER Office Superintendent]', email: '[PLACEHOLDER office.physics@tezu.ac.in]', phone: '[PLACEHOLDER phone]' },
];

// Current default — a second, more admissions-deflecting phrasing is
// drafted in content-notes/contact.md if that fits the department's
// preference better.
const formIntro = 'Have a question for the department? Send us a note and we’ll route it to the right person.';
---

<BaseLayout title="Contact">
  <section class="hero">
    <div class="container">
      <h1>Contact</h1>
      <p class="lede">
        Reach the Department of Physics, Tezpur University &mdash; address,
        general contact info, and department-specific contacts below.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="placeholder-note">
        Address, phone, and contact details below carry [PLACEHOLDER]
        values pending confirmation from the department. The form below is
        a non-functional stub &mdash; a backend/service must be wired up
        before launch.
      </div>

      <h2>Address</h2>
      <p>
        Department of Physics<br />
        [PLACEHOLDER — Building/Block name]<br />
        Tezpur University, Napaam, Tezpur<br />
        [PLACEHOLDER PIN Code], Assam, India
      </p>

      <h2>Email &amp; Phone</h2>
      <p>
        Email: [PLACEHOLDER — physics@tezu.ac.in]<br />
        Phone: [PLACEHOLDER +91-XXXX-XXXXXX]
      </p>

      <h2>Department Contacts</h2>
      <table class="simple-table">
        <thead>
          <tr>
            <th>Office</th>
            <th>Email</th>
            <th>Phone</th>
          </tr>
        </thead>
        <tbody>
          {departmentContacts.map((c) => (
            <tr>
              <td>{c.office}</td>
              <td>{c.email}</td>
              <td>{c.phone}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>Directions</h2>
      <p>
        <strong>By air:</strong> Nearest airport is [PLACEHOLDER &mdash;
        Tezpur Airport (Salonibari) / Guwahati's LGBI, whichever is
        standard], approximately [PLACEHOLDER distance/time] from campus.
        <br />
        <strong>By rail:</strong> Nearest railway station is [PLACEHOLDER
        &mdash; Rangapara North / Tezpur], approximately [PLACEHOLDER
        distance/time] from campus.
        <br />
        <strong>On campus:</strong> The department is located in
        [PLACEHOLDER &mdash; building/block], [PLACEHOLDER &mdash; brief
        landmark, e.g. "near the central library"].
      </p>

      <h2>Get in touch</h2>
      <p>{formIntro}</p>
      {/* This form has no backend wired up — needs a form-handling
          service (e.g. server endpoint, Formspree, or similar) before launch */}
      <form>
        <p>
          <label for="name">Name</label><br />
          <input id="name" name="name" type="text" disabled placeholder="Form not yet wired up" />
        </p>
        <p>
          <label for="email">Email</label><br />
          <input id="email" name="email" type="email" disabled placeholder="Form not yet wired up" />
        </p>
        <p>
          <label for="message">Message</label><br />
          <textarea id="message" name="message" rows="4" disabled placeholder="Form not yet wired up"></textarea>
        </p>
        <button type="button" disabled>Submit (disabled — backend pending)</button>
      </form>
    </div>
  </section>
</BaseLayout>
