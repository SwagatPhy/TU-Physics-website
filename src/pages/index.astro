---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const research = await getCollection('research');
const newsEvents = await getCollection('newsEvents');

const news = newsEvents
	.filter(item => item.data.type === 'news' && !item.data.draft)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3);

const events = newsEvents
	.filter(item => item.data.type === 'event' && !item.data.draft)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3);

const researchPreview = research.slice(0, 3);
---

<!--First div is for the contents / links to about us/ the second division is for the image section (either make it slideshow)-->

<Layout title="Home" description="Official website of the Department of Physics, Tezpur University.">
	<section class="hero-gradient">
		<div class="hero-content">
			<h1>Department of Physics</h1>
			<p class="hero-tagline">Where Curiosity Meets Rigor</p>
			<p class="hero-subtitle">
				We advance the frontiers of physics through research and teaching, preparing students
				to think rigorously about the natural world.
			</p>
			<div class="hero-ctas">
				<a href="/research" class="cta-button primary">Explore Research</a>
				<a href="/admissions" class="cta-button secondary">Admissions</a>
			</div>
            <a href="/about" class="cta-button secondary">Learn more ➡️</a>
		</div>

        <div>
            <img src="/Dept-photos/dept_pho1.jpeg" alt="Department-photo1" class="hero-image">
        </div>


	</section>

	<section class="section highlights">
		<div class="container">
			<div class="highlights-grid">
				<div class="highlight-card">
					<div class="highlight-number">20+</div>
					<div class="highlight-label">Faculty Members</div>
				</div>
				<div class="highlight-card">
					<div class="highlight-number">6</div>
					<div class="highlight-label">Research Areas</div>
				</div>
				<div class="highlight-card">
					<div class="highlight-number">1980</div>
					<div class="highlight-label">Established Since</div>
				</div>
				<div class="highlight-card">
					<div class="highlight-number">500+</div>
					<div class="highlight-label">Active Students</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section mission">
		<div class="container">
            <!--<h2> </h2>-->
			<p class="mission-text">
				The Department of Physics at Tezpur University is committed to excellence in both
				undergraduate and postgraduate education and active research across theoretical and
				experimental physics. Our faculty and scholars work across areas including condensed
				matter physics, quantum optics, nuclear and particle physics, and materials science,
				contributing to academic training and advancing physics research in the region.
			</p>
		</div>
	</section>


    <section class="section programs">
        <div class="container">
            <h2>Teaching and Resesarch</h2>
            <div class="programs-grid">
                <div class='program-card'>
                    <h3>Research</h3>
                        <div>
                        <img src="/Dept-photos/dept_pho1.jpeg" alt="Departmental photo1">

                        </div>
                    <a href="/research" class="program-link">Learn More →</a>

                </div>
                <!--Change the class from program-card to something different, a smaller one-->
                <div class='program-card'>
                    <h3>Admission</h3>
                    <div class='program-card'>
                        <p>Undergraduate Degree</p>
                    </div>
                    <div class='program-card'>
                        <p>Postgraduate Degree</p>
                    </div>
                    <div class='program-card'>
                        <p>Doctoral Degree</p>
                    </div>
                    <a href="/admissions" class="program-link">Learn More →</a>

                </div>

            </div>

        </div>

    </section>



	<section class="section programs">
		<div class="container">
			<h2>Academic Programs</h2>
			<div class="programs-grid">
				<div class="program-tile">
					<h3>Undergraduate</h3>
					<p class="program-degree">B.Sc. Physics</p>
					<p>Three-year rigorous program combining theoretical foundations with laboratory practice.</p>
					<a href="/academics" class="program-link">Learn More →</a>
				</div>
				<div class="program-tile">
					<h3>Postgraduate</h3>
					<p class="program-degree">M.Sc. Physics</p>
					<p>Advanced coursework in specialized research areas with thesis research component.</p>
					<a href="/academics" class="program-link">Learn More →</a>
				</div>
				<div class="program-tile">
					<h3>Doctorate</h3>
					<p class="program-degree">Ph.D. Physics</p>
					<p>Pursue cutting-edge research under faculty supervision across all research areas.</p>
					<a href="/admissions" class="program-link">Learn More →</a>
				</div>
			</div>
		</div>
	</section>


	<section class="section news-events">
		<div class="container">
			<div class="news-events-grid">
				<div class="news-column">
					<h2>Latest News</h2>
					<div class="news-list">
						{news.length > 0 ? (
							news.map(item => (
								<article class="news-item">
									<div class="news-date">
										{item.data.date.toLocaleDateString('en-US', {
											month: 'short',
											day: 'numeric',
											year: 'numeric'
										})}
									</div>
									<h3>{item.data.title}</h3>
									<p>{item.data.summary}</p>
									<a href={`/news-events/${item.id}`} class="read-more">Read More →</a>
								</article>
							))
						) : (
							<p class="no-items">No news items at the moment.</p>
						)}
					</div>
				</div>

				<div class="events-column">
					<h2>Upcoming Events</h2>
					<div class="events-list">
						{events.length > 0 ? (
							events.map(item => (
								<article class="event-item">
									<div class="event-date-badge">
										<div class="event-day">{item.data.date.getDate()}</div>
										<div class="event-month">{item.data.date.toLocaleDateString('en-US', { month: 'short' })}</div>
									</div>
									<div class="event-content">
										<h3>{item.data.title}</h3>
										<p class="event-location">{item.data.location || 'TU Campus'}</p>
										<p>{item.data.summary}</p>
										<a href={`/news-events/${item.id}`} class="read-more">Details →</a>
									</div>
								</article>
							))
						) : (
							<p class="no-items">No upcoming events at the moment.</p>
						)}
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section admissions-cta">
		<div class="container">
			<div class="cta-card">
				<h2>Ready to Join Us?</h2>
				<p>Explore our admissions process and start your physics journey with us.</p>
				<a href="/admissions" class="cta-button primary">View Admissions</a>
			</div>
		</div>
	</section>
</Layout>



