---
import BaseLayout from '../layouts/BaseLayout.astro';

// Six notices across categories so the board reads like a real feed
// instead of near-identical rows.
const notices = [
  { category: 'Exam', title: '[PLACEHOLDER] M.Sc. Physics Semester Exam Schedule', date: '[PLACEHOLDER Month DD, YYYY]' },
  { category: 'Result', title: '[PLACEHOLDER] PhD Entrance Test Result Notification', date: '[PLACEHOLDER Month DD, YYYY]' },
  { category: 'Admissions', title: '[PLACEHOLDER] M.Sc. Physics Admission Notice, [Session]', date: '[PLACEHOLDER Month DD, YYYY]' },
  { category: 'Recruitment', title: '[PLACEHOLDER] Walk-in Interview for Junior Research Fellow (Project: [PLACEHOLDER])', date: '[PLACEHOLDER Month DD, YYYY]' },
  { category: 'Scholarship', title: '[PLACEHOLDER] Call for Applications: Institute Research Fellowship', date: '[PLACEHOLDER Month DD, YYYY]' },
  { category: 'General', title: '[PLACEHOLDER] Department Office Hours Revised for [Semester]', date: '[PLACEHOLDER Month DD, YYYY]' },
];

// Three event formats — seminar, workshop, recurring colloquium — since
// department events don't all look the same.
const events = [
  {
    title: '[PLACEHOLDER Departmental Seminar Series]: "[PLACEHOLDER talk title]"',
    detail: 'Speaker: [PLACEHOLDER Name], [PLACEHOLDER affiliation]',
    when: '[PLACEHOLDER Day, Date, Time]',
    venue: '[PLACEHOLDER — Room / Building / virtual link]',
    extra: '[PLACEHOLDER — abstract text]',
  },
  {
    title: '[PLACEHOLDER Workshop]: "[PLACEHOLDER workshop title, e.g. Hands-on Python for Data Analysis in Physics]"',
    detail: 'Organizers: [PLACEHOLDER Name(s)/lab]',
    when: '[PLACEHOLDER Date range]',
    venue: '[PLACEHOLDER — Room / Building]',
    extra: '[PLACEHOLDER — who it\'s for (UG/PG/PhD), registration link/deadline.]',
  },
  {
    title: '[PLACEHOLDER Colloquium Series] — Recurring',
    detail: 'Frequency: [PLACEHOLDER — e.g. Every second Friday, 4:00 PM]',
    when: '',
    venue: '[PLACEHOLDER — Room / Building, standing venue]',
    extra: '[PLACEHOLDER — one-line description, e.g. "Open departmental talks by invited speakers and senior scholars on current research."] Link to full schedule/archive.',
  },
];
---

<BaseLayout title="Notices & Events">
  <section class="hero">
    <div class="container">
      <h1>Notices &amp; Events</h1>
      <p class="lede">
        Departmental notices &mdash; admissions, exam schedules, results
        &mdash; and upcoming seminars, colloquia, and workshops.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="placeholder-note">
        Notices and events below are [PLACEHOLDER] pending real content
        from the department's notice archive and seminar calendar.
      </div>
      <h2>Notices</h2>
      <table class="simple-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Category</th>
            <th>Notice</th>
          </tr>
        </thead>
        <tbody>
          {notices.map((n) => (
            <tr>
              <td>{n.date}</td>
              <td>{n.category}</td>
              <td>{n.title}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Upcoming Events</h2>
      <div class="card-grid">
        {events.map((e) => (
          <div class="card">
            <h3>{e.title}</h3>
            <p>{e.detail}</p>
            {e.when && <p><strong>When:</strong> {e.when}</p>}
            <p><strong>Venue:</strong> {e.venue}</p>
            <p>{e.extra}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
