---
// Student portal: the student's current courses (active offerings), then past
// courses (finished ones), each with its class links and notes (notes can have
// a file to download and/or a link).
// States: loading → unavailable | not-logged-in | pending | courses | empty.
// Accounts still waiting for admin approval see only the "pending" message.
// Faculty and admin who open this page are sent to /faculty/.
// Course data comes from GET /api/my-courses after login; nothing private is in
// this static page itself.
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PortalPanel from '../components/PortalPanel.astro';
import { copy } from '../lib/portal-copy';
import { portalPages } from '../lib/api';

const text = copy.portal;
---

<Layout title={text.title} noindex>
	<PageHeader title={text.title} lead={text.intro} />

	<section class="section">
		<div class="container">
			<div class="portal-account" id="portal-account" hidden>
				<p>{text.signedInAs} <strong id="portal-name"></strong></p>
				<button class="btn btn--outline" type="button" id="logout-button">{text.logout}</button>
			</div>

			<PortalPanel>
				<div data-state="pending" hidden>
					<h2>{copy.pending.title}</h2>
					<p>{copy.pending.text}</p>
				</div>
				<div data-state="not-logged-in" hidden>
					<p>{text.notLoggedIn}</p>
					<a class="btn btn--navy" href={portalPages.login}>{text.loginLink}</a>
				</div>
				<div data-state="empty" hidden>
					<p>{text.empty}</p>
				</div>
				<div data-state="courses" hidden>
					<h2 class="course-group">{text.currentCourses}</h2>
					<ul class="course-list" id="current-courses"></ul>
					<div id="past-courses-section" hidden>
						<h2 class="course-group">{text.pastCourses}</h2>
						<ul class="course-list" id="past-courses"></ul>
					</div>
				</div>
			</PortalPanel>
		</div>
	</section>
</Layout>

<script>
	import { api, portalPages, fileDownloadUrl } from '../lib/api';
	import { copy } from '../lib/portal-copy';
	import { showState, portalIsAvailable } from '../lib/portal-ui';

	interface Item { id: number; kind: string; title: string; url: string | null; file: { name: string; size: number } | null }
	interface Course {
		code: string;
		title: string;
		programme: string | null;
		batchYear: number | null;
		semester: string;
		contentHidden: boolean;
		resources: Item[];
	}

	const text = copy.portal;

	function element<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, content = '') {
		const node = document.createElement(tag);
		node.className = className;
		node.textContent = content;
		return node;
	}

	// One class link or note: its title (a link if it has a URL, opening in a
	// new tab) and, if it has a file, a Download link.
	function renderItem(item: Item): HTMLLIElement {
		const row = element('li', 'course__item');
		if (item.url) {
			const link = element('a', 'course__link', item.title);
			link.href = item.url; // the API only sends http(s) links
			link.target = '_blank';
			link.rel = 'noopener noreferrer';
			link.append(element('span', 'visually-hidden', ` ${text.opensInNewTab}`));
			row.append(link);
		} else {
			row.append(element('span', 'course__item-title', item.title));
		}
		if (item.file) {
			const download = element('a', 'btn btn--outline course__download', text.download);
			download.href = fileDownloadUrl(item.id);
			download.download = item.file.name;
			download.append(element('span', 'visually-hidden', `: ${item.file.name}`));
			row.append(' ', download, element('span', 'course__file-name', item.file.name));
		}
		return row;
	}

	// A "Class links" or "Notes" heading with its items, or its empty message.
	function renderSection(heading: string, emptyText: string, items: Item[]): HTMLElement[] {
		const parts: HTMLElement[] = [element('h3', 'course__heading', heading)];
		if (items.length === 0) {
			parts.push(element('p', 'course__none', emptyText));
		} else {
			const list = element('ul', 'course__links');
			list.append(...items.map(renderItem));
			parts.push(list);
		}
		return parts;
	}

	// Builds the course cards with DOM methods and textContent only, so course
	// and link titles can never be interpreted as HTML.
	function renderCourses(list: HTMLElement, courses: Course[]) {
		list.replaceChildren(
			...courses.map((course) => {
				const item = element('li', 'course');
				item.append(element('h3', 'course__title', `${course.code} — ${course.title}`));
				item.append(element('p', 'course__semester', course.semester));
				if (course.contentHidden) {
					item.append(element('p', 'course__none', text.contentHidden));
					return item;
				}
				if (course.resources.length === 0) {
					item.append(element('p', 'course__none', text.noLinks));
					return item;
				}
				const links = course.resources.filter((resource) => resource.kind === 'class_link');
				const notes = course.resources.filter((resource) => resource.kind !== 'class_link'); // notes and older 'other' items
				item.append(...renderSection(text.classLinks, text.noClassLinks, links), ...renderSection(text.notes, text.noNotes, notes));
				return item;
			}),
		);
	}

	document.getElementById('logout-button')!.addEventListener('click', async () => {
		await api('logout', { method: 'POST' });
		location.href = portalPages.login;
	});

	async function start() {
		if (!(await portalIsAvailable())) return;
		const me = await api<{ user: { name: string; role: string; status: string; mustChangePassword: boolean } }>('me');
		if (!me.ok) return showState('not-logged-in');
		if (me.data!.user.mustChangePassword) return void (location.href = portalPages.changePassword);

		document.getElementById('portal-name')!.textContent = me.data!.user.name;
		document.getElementById('portal-account')!.hidden = false;
		if (me.data!.user.status === 'pending') return showState('pending');
		if (me.data!.user.role !== 'student') return void (location.href = portalPages.faculty);

		const result = await api<{ current: Course[]; past: Course[] }>('my-courses');
		if (result.error === 'unavailable') return showState('unavailable');
		if (result.error === 'not_logged_in') return showState('not-logged-in');
		if (!result.ok) return showState('not-logged-in');
		const { current, past } = result.data!;
		if (current.length === 0 && past.length === 0) return showState('empty');
		renderCourses(document.getElementById('current-courses')!, current);
		renderCourses(document.getElementById('past-courses')!, past);
		document.getElementById('past-courses-section')!.hidden = past.length === 0; // no heading without past courses
		showState('courses');
	}
	start();
</script>

<style>
	.portal-account {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		max-width: 44rem;
		margin: 0 auto var(--space-md);
	}

	.portal-account p {
		margin: 0;
	}

	/* The course list needs more room than the login-sized panel. */
	section :global(.portal-panel) {
		max-width: 44rem;
	}

	.course-group {
		font-size: 1.35rem;
		margin: 0 0 var(--space-md);
	}

	#past-courses-section {
		margin-top: var(--space-lg);
	}

	:global(.course__semester) {
		margin: 0 0 var(--space-sm);
		color: var(--color-text-muted);
		font-size: 0.92rem;
	}

	.course-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-lg);
	}

	:global(.course__title) {
		font-size: 1.25rem;
		margin-bottom: var(--space-sm);
	}

	:global(.course__links) {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}

	:global(.course__heading) {
		font-size: 1.05rem;
		margin: var(--space-md) 0 var(--space-sm);
	}

	:global(.course__item) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.75rem;
	}

	:global(.course__download) {
		min-height: 2.4rem;
		padding: 0.35rem 0.9rem;
		font-size: 0.9rem;
	}

	:global(.course__file-name) {
		font-size: 0.88rem;
		color: var(--color-text-muted);
	}

	:global(.course__none) {
		margin: 0;
		color: var(--color-text-muted);
	}
</style>
