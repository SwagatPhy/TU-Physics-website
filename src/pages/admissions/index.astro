---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';

const programs = (await getCollection('admissions')).sort((a, b) => a.data.order - b.data.order);

const audiences = [
	{
		href: '/admissions/national',
		icon: 'map-pin',
		eyebrow: 'Indian nationals',
		title: 'National admissions',
		text: 'Information for students from India applying to our programs.',
	},
	{
		href: '/admissions/international',
		icon: 'globe',
		eyebrow: 'International students',
		title: 'International admissions',
		text: 'Information for international students from around the world.',
	},
] as const;
---

<Layout title="Admissions" description="Admissions to the Department of Physics, Tezpur University: Integrated BSc-MSc, Integrated BSc-BEd, MSc and PhD.">
	<PageHeader
		title="Admissions"
		eyebrow="Join the department"
		lead="Admissions to the Department of Physics. Explore our four programs for Indian nationals and international students — start by choosing your applicant category."
	/>

	<section class="section">
		<div class="container">
			<ul class="grid grid--2">
				{audiences.map((item) => (
					<li>
						<a class="card audience-card" href={item.href}>
							<div class="card__body">
								<span class="audience-card__icon"><Icon name={item.icon} /></span>
								<span class="card__eyebrow">{item.eyebrow}</span>
								<h2 class="card__title">{item.title}</h2>
								<p class="card__text">{item.text}</p>
								<span class="card__footer link-arrow">Continue <Icon name="arrow-right" /></span>
							</div>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section section--soft">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">Programs</p>
					<h2>Our programs</h2>
				</div>
			</div>
			<ul class="grid">
				{programs.map((program, i) => (
					<li>
						<a class="card" href={`/admissions/${program.id}`}>
							<div class="card__body">
								<span class="card__eyebrow">0{i + 1} · {program.data.duration}</span>
								<h3 class="card__title">{program.data.title}</h3>
								<p class="card__text">{program.data.tagline}</p>
								<span class="card__footer link-arrow">Program details <Icon name="arrow-right" /></span>
							</div>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
</Layout>

<style>
	.audience-card .card__body {
		padding: var(--space-lg);
	}

	.audience-card .card__title {
		font-size: 1.6rem;
	}

	.audience-card__icon {
		display: grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		margin-bottom: var(--space-sm);
		border-radius: 50%;
		background: var(--navy);
		color: var(--mint);
		font-size: 1.35rem;
	}
</style>
