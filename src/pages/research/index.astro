---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro'

const research = (await getCollection('research')).sort((a,b) => a.data.specialization.localeCompare(b.data.specialization));
const teaching = await getCollection('teaching');
const teachingMap = new Map(teaching.map(p => [p.id, p.data]));

// Resolve faculty IDs to teaching data
// Note: Astro converts filename IDs to lowercase, but research tiles use PascalCase IDs
const researchWithFaculty = research.map(item => ({
    ...item,
    resolvedFaculty: (item.data.faculties || [])
        .filter(f => f.id && typeof f.id === 'string' && !f.id.includes('[PLACEHOLDER'))
        .map(f => {
            const lowercaseId = f.id.toLowerCase();
            return {
                id: f.id,
                lowercaseId,
                group: f.group,
                data: teachingMap.get(lowercaseId),
            };
        })
}));
---

<Layout title="research" description="Current research going on in the Department of Physics.">
    <header class="page-header container">
        <div>
            <h1>Research</h1>
            <p>
                Research in the Department of Physics spans several areas of theoretical and experimental physics. Faculty and research scholars actively publish in peer-reviewed journals and undertake sponsored research projects.
            </p>
        </div>
    </header>

    <section class="research-areas container">
        <div class="card-grid research-grid">
            {researchWithFaculty.map(item => (
                <article class="card research-card">
                    <a href={`/research/${item.id}`} class="card-link">
                        {item.data.image && (
                            <img src={`/Research-areas/${item.data.image}`} alt={item.data.specialization} class="card-image" />
                        )}
                        <h3 class="card-title">{item.data.specialization}</h3>
                        <p class="card-summary">{item.data.description}</p>
                    </a>

                    {item.resolvedFaculty.length > 0 && (
                        <div class="faculty-overlay">
                            <div class="faculty-list">
                                {item.resolvedFaculty.map(faculty => (
                                    <a href={`/people/${faculty.lowercaseId}`} class="faculty-link">
                                        {faculty.data && (
                                            <>
                                                <div class="faculty-name">{faculty.data.name}</div>
                                                {faculty.group && <div class="faculty-group">{faculty.group}</div>}
                                            </>
                                        )}
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}
                </article>
            ))}
        </div>
    </section>
</Layout>

<style>
    /* Four-column board: 4 tiles per row, remaining tiles wrap below */
    .research-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
    }

    .research-card {
        position: relative;
        padding: 0.75rem;
        overflow: hidden;
        border-radius: 8px;
    }

    .card-link {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .card-image {
        width: 100%;
        height: 140px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 0.75rem;
    }

    .faculty-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
        z-index: 10;
    }

    .research-card:hover .faculty-overlay,
    .research-card:focus-within .faculty-overlay {
        opacity: 1;
        pointer-events: auto;
    }

    .faculty-list {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        width: 100%;
        padding: 1.5rem 1rem;
        text-align: center;
    }

    .faculty-link {
        display: block;
        text-decoration: none;
        color: white;
        transition: all 0.2s ease;
        padding: 0.5rem;
        border-radius: 6px;
    }

    .faculty-link:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-2px);
    }

    .faculty-name {
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 0.4rem;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    }

    .faculty-group {
        font-size: 0.85rem;
        opacity: 0.95;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    }

    @media (max-width: 64rem) {
        .research-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 36rem) {
        .research-grid { grid-template-columns: 1fr; }
    }
</style>
