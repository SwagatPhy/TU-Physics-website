						<span class="tab-subtitle">5-Year Program</span>
					</button>
				</div>

				<!-- B.Sc Tab -->
				<div class="tab-content active" id="bsc">
					<div class="program-section">
						<h3>Program Overview</h3>
						<ul>
							<li><strong>Degree Awarded:</strong> B.Sc. Physics (Honours)</li>
							<li><strong>Duration:</strong> [PLACEHOLDER — 3 years / 6 semesters]</li>
							<li><strong>International Intake:</strong> [PLACEHOLDER — XX seats]</li>
