---
import BaseLayout from '../layouts/BaseLayout.astro';

// Structural placeholders only — no real people. Replace with the actual
// roster once the department confirms names, titles, and research areas.
const facultyPlaceholders = [
  { name: '[PLACEHOLDER NAME], Ph.D.', title: 'Professor', area: '[PLACEHOLDER — e.g. Condensed Matter Physics]' },
  { name: '[PLACEHOLDER NAME], Ph.D.', title: 'Associate Professor', area: '[PLACEHOLDER research area]' },
  { name: '[PLACEHOLDER NAME], Ph.D.', title: 'Assistant Professor', area: '[PLACEHOLDER research area]' },
  { name: '[PLACEHOLDER NAME], Ph.D.', title: 'Emeritus Professor', area: '[PLACEHOLDER research area]' },
];
---

<BaseLayout title="Faculty">
  <section class="hero">
    <div class="container">
      <h1>Faculty</h1>
      <p class="lede">
        Directory of the Department of Physics faculty. No real names
        below &mdash; structural placeholders pending the confirmed
        roster, photos, and profile links.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="placeholder-note">
        No real names below. Structural placeholders only, pending the
        department's confirmed roster, headshots, bios, and contact
        details.
      </div>
      <div class="card-grid">
        {facultyPlaceholders.map((f) => (
          <div class="card">
            <h3>{f.name}</h3>
            <p>{f.title}</p>
            <p>Research interests: {f.area}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
