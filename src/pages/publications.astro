---
import BaseLayout from '../layouts/BaseLayout.astro';

// Structural placeholders only — no real papers, authors, or journals
// should be inferred from these entries. Six varied entries (author
// count/subfield/venue type) so the list renders realistically instead
// of near-identical rows.
const publicationPlaceholders = [
  { year: '20XX', citation: '[PLACEHOLDER Author A], Author B, Author C, "[PLACEHOLDER Paper Title — e.g. Structural and optical properties of thin-film X]," [PLACEHOLDER Journal Name], Vol. XX, pp. XXX–XXX. [PLACEHOLDER DOI]' },
  { year: '20XX', citation: 'Author D, [PLACEHOLDER Author A], "[PLACEHOLDER Paper Title — e.g. A theoretical study of Y under high-pressure conditions]," [PLACEHOLDER Journal Name], Vol. XX(X), Article XXXXXX. [PLACEHOLDER DOI]' },
  { year: '20XX', citation: '[PLACEHOLDER Author A], Author E, Author F, Author G, "[PLACEHOLDER Paper Title — e.g. Measurement of Z cross-section at collider energies]," [PLACEHOLDER Journal Name], Vol. XX, pp. XXX–XXX. [PLACEHOLDER arXiv link]' },
  { year: '20XX', citation: '[PLACEHOLDER Author B], "[PLACEHOLDER Paper Title — single-author theory note]," [PLACEHOLDER Journal Name], Vol. XX, pp. XXX–XXX. [PLACEHOLDER DOI]' },
  { year: '20XX', citation: '[PLACEHOLDER Author C], Author H, "[PLACEHOLDER Paper Title — e.g. A review of recent advances in W]," [PLACEHOLDER Journal Name] (Review), Vol. XX, pp. XXX–XXX. [PLACEHOLDER DOI]' },
  { year: '20XX', citation: '[PLACEHOLDER Author A], [PLACEHOLDER Author B], Author I, "[PLACEHOLDER Paper Title — collaborative cross-group paper]," [PLACEHOLDER Journal Name], Vol. XX, pp. XXX–XXX. [PLACEHOLDER DOI]' },
];

const featuredPublication = {
  title: '[PLACEHOLDER Paper Title]',
  authors: '[PLACEHOLDER Author(s)]',
  journal: '[PLACEHOLDER Journal Name]',
  year: '20XX',
  summary: '[PLACEHOLDER one-sentence plain-language summary of why this result matters — e.g. "This work provides the first experimental evidence for X, with implications for Y."]',
};
---

<BaseLayout title="Publications">
  <section class="hero">
    <div class="container">
      <h1>Publications</h1>
      <p class="lede">
        Faculty and research scholars of the Department of Physics, Tezpur
        University publish in peer-reviewed national and international
        journals. Below is a selection of recent publications; a full list
        is available via [PLACEHOLDER &mdash; link to faculty profiles or
        repository].
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="placeholder-note">
        These are structural placeholders only &mdash; no real papers,
        authors, or journals should be inferred from them.
      </div>

      <h2>Featured Publication</h2>
      <p>
        🔬 <strong>Featured:</strong> &ldquo;{featuredPublication.title}&rdquo;
        &mdash; {featuredPublication.authors}, published in <em>{featuredPublication.journal}</em> ({featuredPublication.year}).
        {featuredPublication.summary}
      </p>

      <h2>Recent Publications</h2>
      <ul>
        {publicationPlaceholders.map((pub) => (
          <li>({pub.year}) {pub.citation}</li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
