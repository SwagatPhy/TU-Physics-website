---
import BaseLayout from '../layouts/BaseLayout.astro';

// Hero tagline/mission below use content-notes/home.md's "current
// default" options. Four more tagline variants and three more mission
// blurb variants are drafted there — swap in a different one, or wire
// several up for A/B testing, once the department picks a direction.

const statTiles = [
  { value: '[PLACEHOLDER XX]', label: 'Faculty Members' },
  { value: '[PLACEHOLDER XX]', label: 'PhD Research Scholars' },
  { value: '[PLACEHOLDER 19XX]', label: 'Department Established' },
  { value: '[PLACEHOLDER X]', label: 'Research Groups / Labs' },
];

const highlightCards = [
  {
    title: 'Programs',
    body: 'B.Sc., M.Sc., and PhD programs in Physics, from foundational coursework to advanced research supervision.',
    href: '/academics',
  },
  {
    title: 'Research',
    body: 'Faculty and scholars working across [PLACEHOLDER research areas], publishing in peer-reviewed journals and undertaking sponsored projects.',
    href: '/research',
  },
  {
    title: 'Facilities',
    body: 'Teaching and research laboratories, computing facilities, and shared instrumentation supporting UG, PG, and PhD work.',
    href: '/facilities',
  },
];

// Notice strip: one sample per category, so the feed reads like a real
// notice board rather than three near-identical rows. Swap for the
// department's actual latest notices once available.
const notices = [
  { category: 'Admissions', title: '[PLACEHOLDER] M.Sc. Physics admission notice for [session]', date: '[PLACEHOLDER Month, Year]' },
  { category: 'Exam', title: '[PLACEHOLDER] PhD entrance test schedule announced', date: '[PLACEHOLDER Month, Year]' },
  { category: 'Event', title: '[PLACEHOLDER] Departmental seminar series resumes', date: '[PLACEHOLDER Month, Year]' },
  { category: 'Result', title: '[PLACEHOLDER] M.Sc. Physics semester result declared', date: '[PLACEHOLDER Month, Year]' },
  { category: 'Recruitment', title: '[PLACEHOLDER] Walk-in interview for project JRF position', date: '[PLACEHOLDER Month, Year]' },
  { category: 'General', title: '[PLACEHOLDER] Department office hours revised for [semester]', date: '[PLACEHOLDER Month, Year]' },
];
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="container">
      <h1>Department of Physics, Tezpur University</h1>
      <p class="lede">
        [PLACEHOLDER &mdash; tagline, pending department sign-off]
        &ldquo;Teaching and Research Excellence in Physics.&rdquo;
      </p>
      <p class="lede">
        The Department of Physics at Tezpur University is committed to
        quality undergraduate and postgraduate education and active
        research across theoretical and experimental physics. Our faculty
        and scholars work across areas such as [PLACEHOLDER research
        areas], contributing to both academic training and the advancement
        of physics research in the region.
      </p>
      <a class="button" href="/academics">Explore Programs</a>
      <a class="button" href="/faculty">Meet the Faculty</a>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="card-grid">
        {statTiles.map((stat) => (
          <div class="card">
            <h3>{stat.value}</h3>
            <p>{stat.label}</p>
          </div>
        ))}
      </div>
      <div class="placeholder-note">
        Stat tiles above are structural placeholders &mdash; real figures
        pending confirmation from the department.
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Explore the Department</h2>
      <div class="card-grid">
        {highlightCards.map((card) => (
          <a class="card" href={card.href}>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Notices</h2>
      <ul>
        {notices.map((n) => (
          <li><strong>[{n.category}]</strong> {n.title} &mdash; {n.date}</li>
        ))}
      </ul>
      <p><a href="/notices">View all notices &amp; events &rarr;</a></p>
    </div>
  </section>
</BaseLayout>
