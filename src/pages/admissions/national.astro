---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="National Admissions" description="Admissions information for national students at the Department of Physics.">
	<header class="page-header">
		<div class="container">
			<h1>National Admissions</h1>
			<p>Information and guidelines for Indian students applying to the Department of Physics.</p>
		</div>
	</header>

	<!-- Admissions Type Navigation -->
	<nav class="admissions-nav">
		<div class="container">
			<ul class="nav-tabs">
				<li>
					<a href="/admissions/national" class="nav-tab active">National</a>
				</li>
				<li>
					<a href="/admissions/international" class="nav-tab">International</a>
				</li>
			</ul>
		</div>
	</nav>

	<section class="section">
		<div class="container">
			<h2>Select Your Program</h2>

			<!-- Program Tabs -->
			<div class="program-tabs">
				<div class="tabs-nav">
					<button class="tab-button active" data-tab="bsc">
						<span class="tab-label">B.Sc</span>
						<span class="tab-subtitle">Bachelor of Science</span>
					</button>
					<button class="tab-button" data-tab="msc">
						<span class="tab-label">M.Sc</span>
						<span class="tab-subtitle">Master of Science</span>
					</button>
					<button class="tab-button" data-tab="integrated-bscmsc">
						<span class="tab-label">Integrated B.Sc-M.Sc</span>
						<span class="tab-subtitle">5-Year Program</span>
					</button>
					<button class="tab-button" data-tab="integrated-bscbed">
						<span class="tab-label">Integrated B.Sc-B.Ed</span>
						<span class="tab-subtitle">5-Year Program</span>
					</button>
				</div>

				<!-- B.Sc Tab -->
				<div class="tab-content active" id="bsc">
					<div class="program-section">
						<h3>Eligibility</h3>
						<div class="content-placeholder">
							[B.Sc eligibility requirements will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Application Process</h3>
						<div class="content-placeholder">
							[B.Sc application process details will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Timeline & Important Dates</h3>
						<div class="content-placeholder">
							[B.Sc key dates and timeline will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Required Documents</h3>
						<div class="content-placeholder">
							[B.Sc document checklist will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Contact & Support</h3>
						<div class="content-placeholder">
							[B.Sc contact information will be provided by Notes-manager]
						</div>
					</div>
				</div>

				<!-- M.Sc Tab -->
				<div class="tab-content" id="msc">
					<div class="program-section">
						<h3>Eligibility</h3>
						<div class="content-placeholder">
							[M.Sc eligibility requirements will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Application Process</h3>
						<div class="content-placeholder">
							[M.Sc application process details will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Timeline & Important Dates</h3>
						<div class="content-placeholder">
							[M.Sc key dates and timeline will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Required Documents</h3>
						<div class="content-placeholder">
							[M.Sc document checklist will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Contact & Support</h3>
						<div class="content-placeholder">
							[M.Sc contact information will be provided by Notes-manager]
						</div>
					</div>
				</div>

				<!-- Integrated B.Sc-M.Sc Tab -->
				<div class="tab-content" id="integrated-bscmsc">
					<div class="program-section">
						<h3>Eligibility</h3>
						<div class="content-placeholder">
							[Integrated B.Sc-M.Sc eligibility requirements will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Application Process</h3>
						<div class="content-placeholder">
							[Integrated B.Sc-M.Sc application process details will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Timeline & Important Dates</h3>
						<div class="content-placeholder">
							[Integrated B.Sc-M.Sc key dates and timeline will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Required Documents</h3>
						<div class="content-placeholder">
							[Integrated B.Sc-M.Sc document checklist will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Contact & Support</h3>
						<div class="content-placeholder">
							[Integrated B.Sc-M.Sc contact information will be provided by Notes-manager]
						</div>
					</div>
				</div>

				<!-- Integrated B.Sc-B.Ed Tab -->
				<div class="tab-content" id="integrated-bscbed">
					<div class="program-section">
						<h3>Eligibility</h3>
						<div class="content-placeholder">
							[Integrated B.Sc-B.Ed eligibility requirements will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Application Process</h3>
						<div class="content-placeholder">
							[Integrated B.Sc-B.Ed application process details will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Timeline & Important Dates</h3>
						<div class="content-placeholder">
							[Integrated B.Sc-B.Ed key dates and timeline will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Required Documents</h3>
						<div class="content-placeholder">
							[Integrated B.Sc-B.Ed document checklist will be provided by Notes-manager]
						</div>
					</div>

					<div class="program-section">
						<h3>Contact & Support</h3>
						<div class="content-placeholder">
							[Integrated B.Sc-B.Ed contact information will be provided by Notes-manager]
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<style>
		.admissions-nav {
			border-bottom: 1px solid var(--color-border);
			background: var(--color-bg-alt, #fafafa);
		}

		.nav-tabs {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			gap: 1rem;
		}

		.nav-tab {
			display: block;
			padding: 1rem 1.5rem;
			text-decoration: none;
			color: var(--color-text-muted);
			border-bottom: 2px solid transparent;
			transition: all 0.2s ease;
			font-weight: 500;
		}

		.nav-tab:hover {
			color: var(--color-text);
		}

		.nav-tab.active {
			color: var(--color-accent);
			border-bottom-color: var(--color-accent);
		}

		.program-tabs {
			margin-top: 2rem;
		}

		.tabs-nav {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-bottom: 2rem;
			border-bottom: 2px solid var(--color-border);
			padding-bottom: 1rem;
		}

		.tab-button {
			padding: 0.75rem 1.25rem;
			border: none;
			background: transparent;
			color: var(--color-text-muted);
			cursor: pointer;
			font-size: 0.95rem;
			font-weight: 500;
			border-bottom: 3px solid transparent;
			transition: all 0.2s ease;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.25rem;
		}

		.tab-button:hover {
			color: var(--color-text);
		}

		.tab-button.active {
			color: var(--color-accent);
			border-bottom-color: var(--color-accent);
		}

		.tab-label {
			display: block;
			font-weight: 600;
		}

		.tab-subtitle {
			display: block;
			font-size: 0.8rem;
			font-weight: 400;
			color: var(--color-text-muted);
		}

		.tab-button.active .tab-subtitle {
			color: var(--color-accent);
		}

		.tab-content {
			display: none;
		}

		.tab-content.active {
			display: block;
		}

		.program-section {
			margin-bottom: 2rem;
		}

		.program-section h3 {
			font-size: 1.2rem;
			margin-bottom: 1rem;
			color: var(--color-text);
		}

		.content-placeholder {
			padding: 2rem;
			background: var(--color-bg-alt, #fafafa);
			border: 1px dashed var(--color-border);
			border-radius: 0.5rem;
			color: var(--color-text-muted);
			text-align: center;
			font-style: italic;
			min-height: 4rem;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		@media (max-width: 48rem) {
			.tabs-nav {
				flex-direction: column;
				gap: 0.5rem;
			}

			.tab-button {
				width: 100%;
				align-items: center;
				text-align: center;
			}
		}
	</style>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const tabButtons = document.querySelectorAll('.tab-button');

			tabButtons.forEach(button => {
				button.addEventListener('click', () => {
					const tabId = button.getAttribute('data-tab');

					// Remove active class from all buttons and contents
					tabButtons.forEach(btn => btn.classList.remove('active'));
					document.querySelectorAll('.tab-content').forEach(content => {
						content.classList.remove('active');
					});

					// Add active class to clicked button and corresponding content
					button.classList.add('active');
					document.getElementById(tabId).classList.add('active');
				});
			});
		});
	</script>
</Layout>
