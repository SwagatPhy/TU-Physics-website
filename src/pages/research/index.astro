---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { researchImage } from '../../lib/images';

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);

// Research entries list faculty by file name ("RupjyotiGogoi"); teaching entry
// ids are the lower-cased file name ("rupjyotigogoi").
const teaching = await getCollection('teaching');
const teachingById = new Map(teaching.map((p) => [p.id, p.data]));

const areas = research.map((item) => ({
	...item,
	faculty: item.data.faculties
		.map((f) => ({ id: f.id.toLowerCase(), person: teachingById.get(f.id.toLowerCase()) }))
		.filter((f) => f.person),
}));
---

<Layout title="Research" description="Research areas of the Department of Physics, Tezpur University.">
	<PageHeader
		title="Research"
		eyebrow={`${research.length} areas`}
		lead="Research in the Department of Physics spans several areas of theoretical and experimental physics. Faculty and research scholars actively publish in peer-reviewed journals and undertake sponsored research projects."
	/>

	<section class="section">
		<div class="container">
			<ul class="grid grid--wide">
				{areas.map((item) => (
					<li>
						<article class="card card--link">
							<div class={`card__media ${item.data.image ? '' : 'card__media--plain'}`}>
								{item.data.image && (
									<img src={researchImage(item.data.image)} alt="" loading="lazy" decoding="async" />
								)}
							</div>
							<div class="card__body">
								<h2 class="card__title"><a href={`/research/${item.id}`}>{item.data.specialization}</a></h2>
								{item.data.description && <p class="card__text">{item.data.description}</p>}
								{item.faculty.length > 0 && (
									<div class="card__footer">
										<span class="card__eyebrow">Faculty</span>
										<ul class="faculty-names">
											{item.faculty.map((f) => (
												<li><a href={`/people/${f.id}`}>{f.person!.name}</a></li>
											))}
										</ul>
									</div>
								)}
							</div>
						</article>
					</li>
				))}
			</ul>
		</div>
	</section>
</Layout>

<style>
	.faculty-names {
		list-style: none;
		margin: 0.35rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.9rem;
		font-size: 0.93rem;
	}

	/* Faculty links sit above the card's stretched title link */
	.faculty-names a {
		position: relative;
		z-index: 1;
	}
</style>
