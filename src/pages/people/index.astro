---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PersonCard from '../../components/PersonCard.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../lib/url';

const byName = (a: { data: { name: string } }, b: { data: { name: string } }) => a.data.name.localeCompare(b.data.name);
const teaching = (await getCollection('teaching')).sort(byName);
const nonTeaching = (await getCollection('nonTeaching')).sort(byName);
const scholars = (await getCollection('researchScholars')).sort(byName);
const assistants = (await getCollection('researchAssistants')).sort(byName);

// One entry per tab. `id` links a tab button to its panel below.
const tabs = [
	{ id: 'teaching', label: 'Faculty', heading: 'Teaching faculty', count: teaching.length },
	{ id: 'non-teaching', label: 'Staff', heading: 'Non-teaching staff', count: nonTeaching.length },
	{ id: 'scholars', label: 'Research scholars', heading: 'Research scholars (PhD)', count: scholars.length },
	{ id: 'assistants', label: 'Research assistants', heading: 'Research assistants', count: assistants.length },
];

// Research scholars and assistants share a card shape.
const researcherCard = (p: (typeof scholars)[number] | (typeof assistants)[number]) => ({
	name: p.data.name,
	role: `Supervisor: ${p.data.supervisor}`,
	topics: p.data.research_area ? [p.data.research_area] : [],
	email: p.data.email,
	photo: p.data.photo,
});
---

<Layout title="People" description="Faculty, staff and research scholars of the Department of Physics, Tezpur University.">
	<PageHeader
		title="People"
		eyebrow="Our community"
		lead="Faculty, staff and research scholars of the Department of Physics."
	/>

	<section class="section">
		<div class="container">
			<div class="people-toolbar">
				<div class="tabs" role="tablist" aria-label="People groups">
					{tabs.map((tab, i) => (
						<button
							type="button"
							role="tab"
							class="tab"
							id={`tab-${tab.id}`}
							data-tab={tab.id}
							aria-controls={tab.id}
							aria-selected={i === 0 ? 'true' : 'false'}
							tabindex={i === 0 ? 0 : -1}
						>
							{tab.label}
							<span class="tab__count">{tab.count}</span>
						</button>
					))}
				</div>
				<label class="search-field">
					<span class="visually-hidden">Search people by name or research area</span>
					<Icon name="search" />
					<input type="search" id="people-search" placeholder="Search by name or research area" autocomplete="off" />
				</label>
			</div>

			<section class="panel" id="teaching" role="tabpanel" aria-labelledby="tab-teaching">
				<h2 class="visually-hidden">{tabs[0].heading}</h2>
				<ul class="grid grid--wide">
					{teaching.map((p) => (
						<li>
							<PersonCard
								name={p.data.name}
								role={p.data.designation}
								topics={p.data.research_areas}
								email={p.data.email}
								photo={p.data.photo}
								href={withBase(`/people/${p.id}`)}
							/>
						</li>
					))}
				</ul>
			</section>

			<section class="panel" id="non-teaching" role="tabpanel" aria-labelledby="tab-non-teaching" hidden>
				<h2 class="visually-hidden">{tabs[1].heading}</h2>
				<ul class="grid grid--wide">
					{nonTeaching.map((p) => (
						<li>
							<PersonCard
								name={p.data.name}
								role={p.data.designation}
								topics={p.data.office ? [p.data.office] : []}
								email={p.data.email}
								photo={p.data.photo}
							/>
						</li>
					))}
				</ul>
			</section>

			<section class="panel" id="scholars" role="tabpanel" aria-labelledby="tab-scholars" hidden>
				<h2 class="visually-hidden">{tabs[2].heading}</h2>
				<ul class="grid grid--wide">
					{scholars.map((p) => <li><PersonCard {...researcherCard(p)} /></li>)}
				</ul>
			</section>

			<section class="panel" id="assistants" role="tabpanel" aria-labelledby="tab-assistants" hidden>
				<h2 class="visually-hidden">{tabs[3].heading}</h2>
				<ul class="grid grid--wide">
					{assistants.map((p) => <li><PersonCard {...researcherCard(p)} /></li>)}
				</ul>
			</section>

			<p class="empty-state" id="people-empty" hidden>No one in this group matches your search.</p>
		</div>
	</section>
</Layout>

<script>
	const tabButtons = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
	const panels = document.querySelectorAll<HTMLElement>('.panel');
	const search = document.getElementById('people-search') as HTMLInputElement;
	const empty = document.getElementById('people-empty')!;

	// Show one panel at a time.
	function showPanel(id: string) {
		tabButtons.forEach((b) => {
			const selected = b.dataset.tab === id;
			b.setAttribute('aria-selected', String(selected));
			b.tabIndex = selected ? 0 : -1;
		});
		panels.forEach((p) => (p.hidden = p.id !== id));
		history.replaceState(null, '', `#${id}`);
		applySearch();
	}

	// Hide cards in the visible panel that don't match the search text.
	function applySearch() {
		const query = search.value.trim().toLowerCase();
		const panel = [...panels].find((p) => !p.hidden);
		if (!panel) return;
		let visible = 0;
		panel.querySelectorAll<HTMLElement>('li:has(> [data-person])').forEach((item) => {
			const text = item.querySelector<HTMLElement>('[data-person]')!.dataset.person!;
			item.hidden = query !== '' && !text.includes(query);
			if (!item.hidden) visible++;
		});
		empty.hidden = visible > 0;
	}

	tabButtons.forEach((b) => b.addEventListener('click', () => showPanel(b.dataset.tab!)));
	search.addEventListener('input', applySearch);

	// Arrow keys move between tabs (standard tablist behaviour).
	document.querySelector('[role="tablist"]')!.addEventListener('keydown', (event: Event) => {
		const key = (event as KeyboardEvent).key;
		if (key !== 'ArrowRight' && key !== 'ArrowLeft') return;
		const current = tabButtons.findIndex((b) => b.getAttribute('aria-selected') === 'true');
		const next = tabButtons[(current + (key === 'ArrowRight' ? 1 : -1) + tabButtons.length) % tabButtons.length];
		next.focus();
		showPanel(next.dataset.tab!);
	});

	// Open the tab named in the URL (e.g. /people#scholars), if any.
	const fromUrl = location.hash.slice(1);
	if (document.getElementById(fromUrl)?.classList.contains('panel')) showPanel(fromUrl);
</script>

<style>
	.people-toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		margin-bottom: var(--space-lg);
	}

	.people-toolbar .tabs {
		margin: 0;
	}
</style>
