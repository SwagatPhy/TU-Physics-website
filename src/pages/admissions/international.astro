---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="International Admissions" description="Admissions information for international students at the Department of Physics.">
	<header class="page-header">
		<div class="container">
			<h1>International Admissions</h1>
			<p>Information and guidelines for international students applying to the Department of Physics.</p>
		</div>
	</header>

	<!-- Admissions Type Navigation -->
	<nav class="admissions-nav">
		<div class="container">
			<ul class="nav-tabs">
				<li>
					<a href="/admissions/national" class="nav-tab">National</a>
				</li>
				<li>
					<a href="/admissions/international" class="nav-tab active">International</a>
				</li>
			</ul>
		</div>
	</nav>

	<section class="section">
